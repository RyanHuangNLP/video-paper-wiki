{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.pdf-upload-manifest.v1.schema.json",
  "title": "video-paper-wiki.pdf-upload-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "inventory_sha256", "drive_root_folder_id", "entries"],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.pdf-upload-manifest.v1"
    },
    "inventory_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "drive_root_folder_id": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "entries": {
      "type": "array",
      "maxItems": 65534,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "result",
        "drive_file_id",
        "drive_url",
        "root_folder_id",
        "parent_chain",
        "drive_relative_path",
        "remote_size_bytes",
        "remote_pdf_sha256",
        "verified_at",
        "error"
      ],
      "properties": {
        "item_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "result": {
          "enum": ["uploaded", "reused", "failed", "conflict"]
        },
        "drive_file_id": {
          "type": ["string", "null"],
          "minLength": 10,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "drive_url": {
          "type": ["string", "null"],
          "minLength": 32,
          "maxLength": 2048
        },
        "root_folder_id": {
          "type": ["string", "null"],
          "minLength": 10,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "parent_chain": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/parent"
          }
        },
        "drive_relative_path": {
          "type": ["string", "null"],
          "maxLength": 1024
        },
        "remote_size_bytes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 67108864
        },
        "remote_pdf_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        },
        "error": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/error"}
          ]
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folder_id", "name"],
      "properties": {
        "folder_id": {
          "type": "string",
          "minLength": 10,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retryable": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
