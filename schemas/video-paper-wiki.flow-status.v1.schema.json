{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.flow-status.v1.schema.json",
  "title": "video-paper-wiki.flow-status.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "batch_id",
    "paper_filter",
    "basis",
    "article_store_inventory_sha256",
    "selection",
    "counts",
    "stages",
    "papers",
    "missing_inputs",
    "next_actions",
    "publication",
    "applied",
    "vault_written",
    "write_kind",
    "audit_coverage",
    "ranking",
    "typed_fact_promotion",
    "canonical_official",
    "current_supported_typed_fact",
    "next_action"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.flow-status.v1"
    },
    "state": {
      "const": "flow_status"
    },
    "batch_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
        }
      ]
    },
    "paper_filter": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        }
      ]
    },
    "basis": {
      "$ref": "#/$defs/output_basis"
    },
    "article_store_inventory_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "selection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/selection_view"
        }
      ]
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "stages": {
      "$ref": "#/$defs/stages"
    },
    "papers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8192,
      "items": {
        "$ref": "#/$defs/paper_row"
      }
    },
    "missing_inputs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/missing_input"
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/next_action_item"
      }
    },
    "publication": {
      "const": "unpublished"
    },
    "applied": {
      "const": false,
      "type": "boolean"
    },
    "vault_written": {
      "const": false,
      "type": "boolean"
    },
    "write_kind": {
      "const": "read_only"
    },
    "audit_coverage": {
      "const": "not_wired"
    },
    "ranking": {
      "const": "not_ranked"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
    "next_action": {
      "const": "follow_next_actions"
    }
  },
  "$defs": {
    "output_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_store_inventory_sha256",
        "claim_ledger_sha256",
        "assessment_heads_sha256",
        "experiment_store_inventory_sha256"
      ],
      "properties": {
        "domain_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "claim_ledger_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "assessment_heads_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "experiment_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "selection_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_ids",
        "association_id",
        "question",
        "basis_state"
      ],
      "properties": {
        "paper_ids": {
          "$ref": "#/$defs/paper_ids"
        },
        "association_id": {
          "$ref": "#/$defs/association_id_or_null"
        },
        "question": {
          "$ref": "#/$defs/question_or_null"
        },
        "basis_state": {
          "enum": [
            "current",
            "changed"
          ]
        }
      }
    },
    "paper_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
      }
    },
    "association_id_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 68,
          "maxLength": 68,
          "pattern": "^sva-[0-9a-f]{64}$(?![\\s\\S])"
        }
      ]
    },
    "question_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "papers",
        "lineages",
        "conditions",
        "pairwise",
        "articles",
        "staged_articles"
      ],
      "properties": {
        "papers": {
          "$ref": "#/$defs/nonneg"
        },
        "lineages": {
          "$ref": "#/$defs/nonneg"
        },
        "conditions": {
          "$ref": "#/$defs/nonneg"
        },
        "pairwise": {
          "$ref": "#/$defs/nonneg"
        },
        "articles": {
          "$ref": "#/$defs/nonneg"
        },
        "staged_articles": {
          "$ref": "#/$defs/nonneg"
        }
      }
    },
    "nonneg": {
      "type": "integer",
      "minimum": 0
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discover",
        "annotate",
        "compare",
        "survey",
        "publish"
      ],
      "properties": {
        "discover": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "paper_count"
          ],
          "properties": {
            "state": {
              "enum": [
                "empty",
                "papers_known"
              ]
            },
            "paper_count": {
              "$ref": "#/$defs/nonneg"
            }
          }
        },
        "annotate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lineage_count",
            "by_typed_fact_status"
          ],
          "properties": {
            "lineage_count": {
              "$ref": "#/$defs/nonneg"
            },
            "by_typed_fact_status": {
              "$ref": "#/$defs/count_map"
            }
          }
        },
        "compare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "condition_count",
            "pairwise_count",
            "by_verdict"
          ],
          "properties": {
            "condition_count": {
              "$ref": "#/$defs/nonneg"
            },
            "pairwise_count": {
              "$ref": "#/$defs/nonneg"
            },
            "by_verdict": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 4,
              "patternProperties": {
                "^(comparable|comparable_with_caveats|incomparable|insufficient_conditions)$": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "survey": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "article_count",
            "complete_count",
            "in_progress_count"
          ],
          "properties": {
            "article_count": {
              "$ref": "#/$defs/nonneg"
            },
            "complete_count": {
              "$ref": "#/$defs/nonneg"
            },
            "in_progress_count": {
              "$ref": "#/$defs/nonneg"
            }
          }
        },
        "publish": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "agent_apply"
          ],
          "properties": {
            "state": {
              "const": "unpublished"
            },
            "agent_apply": {
              "const": "not_available"
            }
          }
        }
      }
    },
    "count_map": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "paper_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "selected",
        "lineages",
        "conditions",
        "articles"
      ],
      "properties": {
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "selected": {
          "type": "boolean"
        },
        "lineages": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/lineage_row"
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/condition_row"
          }
        },
        "articles": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/article_row"
          }
        }
      }
    },
    "lineage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "head_annotation_id",
        "current_review_id",
        "review_decision",
        "reviewed_officiality",
        "typed_fact_status",
        "source_association_id",
        "association_status",
        "version_status",
        "source_id",
        "version",
        "repository",
        "commit"
      ],
      "properties": {
        "lineage_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/lineage_id"
        },
        "head_annotation_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/annotation_id"
        },
        "current_review_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/review_id"
            }
          ]
        },
        "review_decision": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/review_decision"
        },
        "reviewed_officiality": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/reviewed_officiality"
        },
        "typed_fact_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$(?![\\s\\S])"
        },
        "source_association_id": {
          "type": "string",
          "minLength": 68,
          "maxLength": 68,
          "pattern": "^sva-[0-9a-f]{64}$(?![\\s\\S])"
        },
        "association_status": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/association_status"
        },
        "version_status": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_status"
        },
        "source_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/source_id_or_null"
        },
        "version": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_or_null"
        },
        "repository": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/repository"
        },
        "commit": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/full_commit"
        }
      }
    },
    "condition_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "setting_key",
        "head_record_id",
        "record_status",
        "condition_status",
        "critical_unknown"
      ],
      "properties": {
        "condition_id": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^exc-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "setting_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$(?![\\s\\S])"
        },
        "head_record_id": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "record_status": {
          "enum": [
            "current",
            "stale"
          ]
        },
        "condition_status": {
          "$ref": "#/$defs/condition_status"
        },
        "critical_unknown": {
          "type": "array",
          "minItems": 0,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/condition_slot"
          }
        }
      }
    },
    "condition_slot": {
      "enum": [
        "model_checkpoint",
        "parameter_count",
        "dataset_split",
        "metrics",
        "resolution",
        "frames",
        "inference_steps",
        "sampling_guidance",
        "evaluation_setup"
      ]
    },
    "slot_status": {
      "enum": [
        "reported",
        "derived",
        "unknown",
        "not_applicable"
      ]
    },
    "condition_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_checkpoint",
        "parameter_count",
        "dataset_split",
        "metrics",
        "resolution",
        "frames",
        "inference_steps",
        "sampling_guidance",
        "evaluation_setup"
      ],
      "properties": {
        "model_checkpoint": {
          "$ref": "#/$defs/slot_status"
        },
        "parameter_count": {
          "$ref": "#/$defs/slot_status"
        },
        "dataset_split": {
          "$ref": "#/$defs/slot_status"
        },
        "metrics": {
          "$ref": "#/$defs/slot_status"
        },
        "resolution": {
          "$ref": "#/$defs/slot_status"
        },
        "frames": {
          "$ref": "#/$defs/slot_status"
        },
        "inference_steps": {
          "$ref": "#/$defs/slot_status"
        },
        "sampling_guidance": {
          "$ref": "#/$defs/slot_status"
        },
        "evaluation_setup": {
          "$ref": "#/$defs/slot_status"
        }
      }
    },
    "article_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article_id",
        "head_revision_id",
        "head_location",
        "progress",
        "complete",
        "next_section_id"
      ],
      "properties": {
        "article_id": {
          "type": "string",
          "pattern": "^art-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "head_revision_id": {
          "type": "string",
          "pattern": "^arv-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "head_location": {
          "enum": [
            "staged",
            "vault_store"
          ]
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provisional",
            "unknown",
            "unwritten"
          ],
          "properties": {
            "provisional": {
              "$ref": "#/$defs/nonneg"
            },
            "unknown": {
              "$ref": "#/$defs/nonneg"
            },
            "unwritten": {
              "$ref": "#/$defs/nonneg"
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "next_section_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^s[1-9][0-9]?$(?![\\s\\S])"
            }
          ]
        }
      }
    },
    "missing_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "field",
        "reason",
        "candidates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "candidates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "stage": {
      "enum": [
        "discover",
        "annotate",
        "compare",
        "survey",
        "publish",
        "session"
      ]
    },
    "next_action_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "reason",
        "argv",
        "placeholders",
        "writes",
        "leaf_check"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "argv": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "placeholders": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^<[a-z0-9_]+>$(?![\\s\\S])"
          }
        },
        "writes": {
          "enum": [
            "none",
            "work_staging"
          ]
        },
        "leaf_check": {
          "enum": [
            "command_tree",
            "module_entry"
          ]
        }
      }
    }
  }
}
