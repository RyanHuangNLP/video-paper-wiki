{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.pdf-locations.v1.schema.json",
  "title": "video-paper-wiki.pdf-locations.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "paper_id", "pdfs"],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.pdf-locations.v1"
    },
    "paper_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
    },
    "pdfs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/pdf_entry"
      }
    }
  },
  "$defs": {
    "pdf_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdf_sha256",
        "size_bytes",
        "media_type",
        "drive",
        "local_refs",
        "cache_policy",
        "verification"
      ],
      "properties": {
        "pdf_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 67108864
        },
        "media_type": {
          "type": ["string", "null"],
          "enum": ["application/pdf", null]
        },
        "drive": {
          "$ref": "#/$defs/drive_locator"
        },
        "local_refs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/local_ref"
          }
        },
        "cache_policy": {
          "const": "keep-local"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "drive_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "url", "root_folder_id", "relative_path"],
      "properties": {
        "file_id": {
          "type": "string",
          "minLength": 10,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "url": {
          "type": "string",
          "minLength": 32,
          "maxLength": 2048,
          "pattern": "^https://drive\\.google\\.com/file/d/[A-Za-z0-9_-]+/view(?:\\?resourcekey=[A-Za-z0-9._~-]+)?$"
        },
        "root_folder_id": {
          "type": "string",
          "minLength": 10,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "relative_path": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "local_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "relative_path"],
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_at", "method"],
      "properties": {
        "status": {
          "enum": ["unverified", "verified"]
        },
        "checked_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        },
        "method": {
          "type": ["string", "null"],
          "enum": ["download-sha256", null]
        }
      }
    }
  }
}
