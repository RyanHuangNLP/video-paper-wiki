{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.article-revision-record.v1.schema.json",
  "title": "video-paper-wiki.article-revision-record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "article_id",
    "revision_id",
    "previous_revision_id",
    "content_sha256",
    "recorded_by",
    "recorded_at",
    "question",
    "paper_ids",
    "context_sha256",
    "basis",
    "kind",
    "target_section_id",
    "instructions",
    "title",
    "sections",
    "bibliography",
    "comparison_table",
    "progress",
    "publication",
    "canonical_official",
    "current_supported_typed_fact",
    "typed_fact_promotion",
    "ranking",
    "scientific_conclusion_contradiction"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.article-revision-record.v1"
    },
    "article_id": {
      "type": "string",
      "pattern": "^art-[0-9a-f]{20}$(?![\\s\\S])"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^arv-[0-9a-f]{20}$(?![\\s\\S])"
    },
    "previous_revision_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^arv-[0-9a-f]{20}$(?![\\s\\S])"
        }
      ]
    },
    "content_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recorded_at": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/utc_timestamp"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "paper_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
      }
    },
    "context_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_store_inventory_sha256",
        "claim_ledger_sha256",
        "assessment_heads_sha256",
        "experiment_store_inventory_sha256",
        "graph_sha256",
        "matrix_sha256"
      ],
      "properties": {
        "domain_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "claim_ledger_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "assessment_heads_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "experiment_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "graph_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "matrix_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "kind": {
      "enum": [
        "outline",
        "section",
        "full"
      ]
    },
    "target_section_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^s[1-9][0-9]?$(?![\\s\\S])"
        }
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4000
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "bibliography": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/biblio"
      }
    },
    "comparison_table": {
      "$ref": "#/$defs/comparison_table"
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provisional",
        "unknown",
        "unwritten"
      ],
      "properties": {
        "provisional": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "unwritten": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "publication": {
      "const": "unpublished"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "ranking": {
      "const": "not_ranked"
    },
    "scientific_conclusion_contradiction": {
      "const": false,
      "type": "boolean"
    }
  },
  "$defs": {
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text_sha256",
            "assessment",
            "head_event_id",
            "freshness"
          ],
          "properties": {
            "text_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "assessment": {
              "enum": [
                "accepted",
                "provisional",
                "contested",
                "unsupported",
                "deprecated"
              ]
            },
            "head_event_id": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              ]
            },
            "freshness": {
              "enum": [
                "head_bound",
                "stale",
                "unannotated"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "association_id",
            "path",
            "sha256",
            "charspan",
            "excerpt_sha256",
            "relation",
            "quote_status",
            "version"
          ],
          "properties": {
            "association_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "charspan": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              }
            },
            "excerpt_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "relation": {
              "enum": [
                "supports",
                "contradicts",
                "uncertain"
              ]
            },
            "quote_status": {
              "enum": [
                "bound",
                "source_missing",
                "source_changed",
                "excerpt_changed"
              ]
            },
            "version": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_or_null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_record_id",
            "head_record_sha256",
            "version",
            "record_status",
            "association_status",
            "source_status",
            "binding_status"
          ],
          "properties": {
            "head_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "head_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "version": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_or_null"
            },
            "record_status": {
              "enum": [
                "current",
                "stale"
              ]
            },
            "association_status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "source_status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "binding_status": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_record_id",
            "head_record_sha256",
            "column",
            "status",
            "value_summary"
          ],
          "properties": {
            "head_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "head_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "column": {
              "enum": [
                "model_checkpoint",
                "parameter_count",
                "dataset_split",
                "metrics",
                "resolution",
                "frames",
                "inference_steps",
                "sampling_guidance",
                "evaluation_setup"
              ]
            },
            "status": {
              "enum": [
                "reported",
                "derived",
                "unknown",
                "not_applicable"
              ]
            },
            "value_summary": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_record_id",
            "head_record_sha256",
            "name",
            "unit",
            "value",
            "higher_is_better"
          ],
          "properties": {
            "head_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "head_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "unit": {
              "enum": [
                "score",
                "percent",
                "fvd",
                "fid",
                "kvd",
                "is",
                "clip_score",
                "ms",
                "seconds",
                "fps",
                "unitless",
                "other"
              ]
            },
            "value": {
              "type": "number"
            },
            "higher_is_better": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_annotation_id",
            "head_report_sha256",
            "repository",
            "commit",
            "relation_kind",
            "reviewed_officiality",
            "relation_status"
          ],
          "properties": {
            "head_annotation_id": {
              "type": "string",
              "pattern": "^dan-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "head_report_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "repository": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/repository"
            },
            "commit": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/full_commit"
            },
            "relation_kind": {
              "enum": [
                "this_paper_implementation",
                "baseline",
                "dependency",
                "third_party_reproduction",
                "unknown"
              ]
            },
            "reviewed_officiality": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            },
            "relation_status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left_record_id",
            "right_record_id",
            "left_record_sha256",
            "right_record_sha256",
            "verdict",
            "ranking",
            "contradiction_candidate_count",
            "same_paper"
          ],
          "properties": {
            "left_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "right_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "left_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "right_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "verdict": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "ranking": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "contradiction_candidate_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "same_paper": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "association_id",
            "version",
            "association_status",
            "source_status",
            "raw_sha256"
          ],
          "properties": {
            "association_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_or_null"
            },
            "association_status": {
              "enum": [
                "bound",
                "missing",
                "changed",
                "identity_mismatch"
              ]
            },
            "source_status": {
              "enum": [
                "bound",
                "missing",
                "changed"
              ]
            },
            "raw_sha256": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
                }
              ]
            }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "role",
        "title",
        "goal",
        "status",
        "markdown",
        "citations"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^s[1-9][0-9]?$(?![\\s\\S])"
        },
        "role": {
          "enum": [
            "question",
            "background",
            "consensus",
            "differences",
            "controversies",
            "comparison",
            "limits",
            "unknowns"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "unwritten",
            "unknown",
            "provisional"
          ]
        },
        "markdown": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16000
        },
        "citations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^aev-[0-9a-f]{20}$(?![\\s\\S])"
          }
        }
      }
    },
    "biblio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "paper_id",
        "label",
        "source",
        "binding",
        "status_at_export"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^aev-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "claim",
            "claim_span",
            "condition",
            "condition_value",
            "metric_value",
            "code_lineage",
            "comparability",
            "source_version"
          ]
        },
        "paper_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_kind",
            "record_id",
            "json_pointer"
          ],
          "properties": {
            "record_kind": {
              "enum": [
                "claim_ledger",
                "assessment_heads",
                "association_record",
                "experiment_record",
                "annotation",
                "review",
                "derived"
              ]
            },
            "record_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "json_pointer": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512
            }
          }
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "status_at_export": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "table_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value_summary",
        "evidence_id"
      ],
      "properties": {
        "status": {
          "enum": [
            "reported",
            "derived",
            "unknown",
            "not_applicable"
          ]
        },
        "value_summary": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^aev-[0-9a-f]{20}$(?![\\s\\S])"
        }
      }
    },
    "table_cells": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_checkpoint",
        "parameter_count",
        "dataset_split",
        "metrics",
        "resolution",
        "frames",
        "inference_steps",
        "sampling_guidance",
        "evaluation_setup"
      ],
      "properties": {
        "model_checkpoint": {
          "$ref": "#/$defs/table_cell"
        },
        "parameter_count": {
          "$ref": "#/$defs/table_cell"
        },
        "dataset_split": {
          "$ref": "#/$defs/table_cell"
        },
        "metrics": {
          "$ref": "#/$defs/table_cell"
        },
        "resolution": {
          "$ref": "#/$defs/table_cell"
        },
        "frames": {
          "$ref": "#/$defs/table_cell"
        },
        "inference_steps": {
          "$ref": "#/$defs/table_cell"
        },
        "sampling_guidance": {
          "$ref": "#/$defs/table_cell"
        },
        "evaluation_setup": {
          "$ref": "#/$defs/table_cell"
        }
      }
    },
    "cmp_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "condition_id",
        "paper_id",
        "setting_key",
        "version",
        "head_record_id",
        "head_record_sha256",
        "row_status",
        "cells"
      ],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "condition_id": {
          "type": "string",
          "pattern": "^exc-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "setting_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_or_null"
        },
        "head_record_id": {
          "type": "string",
          "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "head_record_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "row_status": {
          "enum": [
            "current",
            "stale"
          ]
        },
        "cells": {
          "$ref": "#/$defs/table_cells"
        }
      }
    },
    "metric_column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "unit": {
          "enum": [
            "score",
            "percent",
            "fvd",
            "fid",
            "kvd",
            "is",
            "clip_score",
            "ms",
            "seconds",
            "fps",
            "unitless",
            "other"
          ]
        }
      }
    },
    "cmp_metric_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "name",
        "unit",
        "value",
        "higher_is_better",
        "evidence_id"
      ],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "unit": {
          "enum": [
            "score",
            "percent",
            "fvd",
            "fid",
            "kvd",
            "is",
            "clip_score",
            "ms",
            "seconds",
            "fps",
            "unitless",
            "other"
          ]
        },
        "value": {
          "type": "number"
        },
        "higher_is_better": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^aev-[0-9a-f]{20}$(?![\\s\\S])"
        }
      }
    },
    "comparison_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "metric_columns",
        "metric_cells"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/cmp_row"
          }
        },
        "metric_columns": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/metric_column"
          }
        },
        "metric_cells": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/cmp_metric_cell"
          }
        }
      }
    }
  }
}
