{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.ingest-plan.v1.schema.json",
  "title": "video-paper-wiki.ingest-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_kind", "batch_id", "input", "limits", "network_targets", "parser", "approval_hash"],
  "properties": {
    "schema": {"const": "video-paper-wiki.ingest-plan.v1"},
    "plan_kind": {"enum": ["paper-source", "code-evidence"]},
    "batch_id": {"type": "string", "minLength": 1},
    "input": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "local_sha256"], "properties": {"kind": {"const": "local-blob"}, "local_sha256": {"$ref": "#/$defs/sha256"}, "arxiv_id": {"type": "string"}, "pdf_url": {"type": "string"}, "repository": {"$ref": "#/$defs/repository"}, "commit": {"$ref": "#/$defs/commit"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "arxiv_id"], "properties": {"kind": {"const": "arxiv"}, "local_sha256": {"$ref": "#/$defs/sha256"}, "arxiv_id": {"type": "string", "minLength": 1}, "pdf_url": {"type": "string"}, "repository": {"$ref": "#/$defs/repository"}, "commit": {"$ref": "#/$defs/commit"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "repository", "commit"], "properties": {"kind": {"const": "github-repo"}, "local_sha256": {"$ref": "#/$defs/sha256"}, "arxiv_id": {"type": "string"}, "pdf_url": {"type": "string"}, "repository": {"$ref": "#/$defs/repository"}, "commit": {"$ref": "#/$defs/commit"}}}
    ]},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_bytes", "max_requests"], "properties": {"max_pages": {"type": "integer", "minimum": 1}, "max_bytes": {"type": "integer", "minimum": 1}, "max_requests": {"type": "integer", "minimum": 1}}},
    "network_targets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["url", "host", "method", "redirect_hosts", "max_bytes"], "properties": {"url": {"type": "string"}, "host": {"type": "string", "minLength": 1}, "method": {"enum": ["GET", "HEAD"]}, "redirect_hosts": {"type": "array", "items": {"type": "string", "minLength": 1}}, "max_bytes": {"type": "integer", "minimum": 1}}}},
    "parser": {"type": "object", "additionalProperties": false, "required": ["engine", "engine_version", "config_sha256", "model_manifest_sha256"], "properties": {"engine": {"const": "docling"}, "engine_version": {"type": "string", "minLength": 1}, "config_sha256": {"$ref": "#/$defs/sha256"}, "model_manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "approval_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [{"if": {"required": ["plan_kind"], "patternProperties": {"^plan_kind$": {"const": "paper-source"}}}, "then": {"patternProperties": {"^limits$": {"required": ["max_pages"]}}}}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"}
  }
}
