  "$defs": {
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_sha256",
        "condition_id",
        "paper_id",
        "source_association_id",
        "setting_key"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "record_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "condition_id": {
          "type": "string",
          "pattern": "^exc-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "source_association_id": {
          "type": "string",
          "minLength": 68,
          "maxLength": 68,
          "pattern": "^sva-[0-9a-f]{64}$(?![\\s\\S])"
        },
        "setting_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$(?![\\s\\S])"
        }
      }
    },
    "incomparable_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "kind",
        "field_pointer",
        "left_summary",
        "right_summary",
        "evidence_needed"
      ],
      "properties": {
        "rule": {
          "enum": [
            "same_benchmark_and_split",
            "same_metric_definition",
            "same_metric_unit",
            "same_resolution",
            "same_frame_count",
            "same_evaluation_protocol",
            "checkpoint_identified",
            "parameter_basis_declared",
            "inference_steps_declared",
            "guidance_declared",
            "same_source_version_within_paper"
          ]
        },
        "kind": {
          "enum": [
            "condition_differs",
            "condition_unknown",
            "unit_mismatch",
            "metric_definition_differs",
            "no_shared_metric"
          ]
        },
        "field_pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "left_summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "right_summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_needed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "condition_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_pointer",
        "left_summary",
        "right_summary"
      ],
      "properties": {
        "field_pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "left_summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "right_summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "contradiction_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_name",
        "unit",
        "left_value",
        "right_value",
        "higher_is_better",
        "comparability_verdict",
        "left_claim_ids",
        "right_claim_ids",
        "detail"
      ],
      "properties": {
        "metric_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "unit": {
          "enum": [
            "score",
            "percent",
            "fvd",
            "fid",
            "kvd",
            "is",
            "clip_score",
            "ms",
            "seconds",
            "fps",
            "unitless",
            "other"
          ]
        },
        "left_value": {
          "type": "number"
        },
        "right_value": {
          "type": "number"
        },
        "higher_is_better": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparability_verdict": {
          "const": "comparable"
        },
        "left_claim_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/claim_id"
          }
        },
        "right_claim_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/claim_id"
          }
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
