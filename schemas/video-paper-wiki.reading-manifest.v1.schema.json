{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.reading-manifest.v1.schema.json",
  "title": "video-paper-wiki.reading-manifest.v1",
  "description": "P2-R1 §2.6 冻结的 22 键 manifest；有意不含 `schema` 键以保持 `.work/<batch>/reading/manifest.json` 字节不变，由 `view_kind` 自描述；`staging` 只在 CLI `data` 中，不属于本文档",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "view_kind",
    "state",
    "batch_id",
    "articles_batch",
    "paper_filter",
    "install_path",
    "basis",
    "article_store_inventory_sha256",
    "graph_sha256",
    "matrix_sha256",
    "counts",
    "stale_counts",
    "articles",
    "pages",
    "publication",
    "applied",
    "vault_written",
    "write_kind",
    "audit_coverage",
    "backup_coverage",
    "ranking",
    "typed_fact_promotion",
    "canonical_official",
    "current_supported_typed_fact",
    "next_action"
  ],
  "properties": {
    "view_kind": {
      "const": "obsidian-reading.v1"
    },
    "state": {
      "const": "reading_staged"
    },
    "batch_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
    },
    "articles_batch": {
      "anyOf": [
        {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "paper_filter": {
      "anyOf": [
        {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "install_path": {
      "const": "wiki/reading"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_store_inventory_sha256",
        "claim_ledger_sha256",
        "assessment_heads_sha256",
        "experiment_store_inventory_sha256"
      ],
      "properties": {
        "domain_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "claim_ledger_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "assessment_heads_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "experiment_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "article_store_inventory_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "graph_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "matrix_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "papers",
        "versions",
        "concepts",
        "claims",
        "lineages",
        "conditions",
        "pairwise",
        "articles",
        "pages"
      ],
      "properties": {
        "papers": {
          "type": "integer",
          "minimum": 0
        },
        "versions": {
          "type": "integer",
          "minimum": 0
        },
        "concepts": {
          "type": "integer",
          "minimum": 0
        },
        "claims": {
          "type": "integer",
          "minimum": 0
        },
        "lineages": {
          "type": "integer",
          "minimum": 0
        },
        "conditions": {
          "type": "integer",
          "minimum": 0
        },
        "pairwise": {
          "type": "integer",
          "minimum": 0
        },
        "articles": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stale_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "articles": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "article_id",
          "head_revision_id",
          "head_location",
          "check_status",
          "complete",
          "render_path",
          "render_sha256"
        ],
        "properties": {
          "article_id": {
            "type": "string",
            "pattern": "^art-[0-9a-f]{20}$(?![\\s\\S])"
          },
          "head_revision_id": {
            "type": "string",
            "pattern": "^arv-[0-9a-f]{20}$(?![\\s\\S])"
          },
          "head_location": {
            "enum": [
              "staged",
              "vault_store"
            ]
          },
          "check_status": {
            "enum": [
              "current",
              "affected",
              "inconsistent"
            ]
          },
          "complete": {
            "type": "boolean"
          },
          "render_path": {
            "type": "string",
            "pattern": "^\\.work/[A-Za-z0-9][A-Za-z0-9_-]{0,127}/articles/render/art-[0-9a-f]{20}/arv-[0-9a-f]{20}\\.md$(?![\\s\\S])"
          },
          "render_sha256": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*\\.md$(?![\\s\\S])"
          },
          "sha256": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "publication": {
      "const": "unpublished"
    },
    "applied": {
      "const": false,
      "type": "boolean"
    },
    "vault_written": {
      "const": false,
      "type": "boolean"
    },
    "write_kind": {
      "const": "work_staging"
    },
    "audit_coverage": {
      "const": "not_wired"
    },
    "backup_coverage": {
      "const": "not_wired"
    },
    "ranking": {
      "const": "not_ranked"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
    "next_action": {
      "const": "open_in_obsidian"
    }
  }
}
