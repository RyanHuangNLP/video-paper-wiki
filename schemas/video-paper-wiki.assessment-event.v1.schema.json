{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.assessment-event.v1.schema.json", "title": "video-paper-wiki.assessment-event.v1",
  "$comment": "event_id = \"ase-\" + SHA256(RFC8785-JCS(event without event_id)).hexdigest()[:20]. Allowed transitions: system genesis: null -> provisional; system evidence_invalidation: any current -> provisional; human human_assessment: any current -> accepted|contested|unsupported|deprecated. No human path to accepted exists except human_assessment. No no-op is allowed except evidence_invalidation provisional->provisional.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "event_id", "claim_id", "previous_event_id", "actor_kind", "transition_kind", "from_assessment", "to_assessment", "claim_text_sha256", "evidence_fingerprint", "decided_by", "decided_at", "reason"],
  "properties": {
    "schema": {"const": "video-paper-wiki.assessment-event.v1"}, "event_id": {"type": "string", "pattern": "^ase-[0-9a-f]{20}$"}, "claim_id": {"type": "string", "pattern": "^clm-[0-9a-f]{20}$"},
    "previous_event_id": {"type": ["string", "null"], "pattern": "^ase-[0-9a-f]{20}$"}, "actor_kind": {"enum": ["system", "human"]}, "transition_kind": {"enum": ["genesis", "human_assessment", "evidence_invalidation"]},
    "from_assessment": {"type": ["string", "null"], "enum": [null, "provisional", "accepted", "contested", "unsupported", "deprecated"]}, "to_assessment": {"enum": ["provisional", "accepted", "contested", "unsupported", "deprecated"]},
    "claim_text_sha256": {"$ref": "#/$defs/sha256"}, "evidence_fingerprint": {"$ref": "#/$defs/sha256"}, "decided_by": {"type": "string"}, "decided_at": {"type": "string", "format": "date-time"}, "reason": {"type": "string"}
  },
  "oneOf": [
    {"required": ["actor_kind", "transition_kind", "from_assessment", "to_assessment", "previous_event_id"], "patternProperties": {"^actor_kind$": {"const": "system"}, "^transition_kind$": {"const": "genesis"}, "^from_assessment$": {"type": "null"}, "^to_assessment$": {"const": "provisional"}, "^previous_event_id$": {"type": "null"}}},
    {"required": ["actor_kind", "transition_kind", "from_assessment", "to_assessment"], "patternProperties": {"^actor_kind$": {"const": "system"}, "^transition_kind$": {"const": "evidence_invalidation"}, "^from_assessment$": {"type": "string"}, "^to_assessment$": {"const": "provisional"}}},
    {"required": ["actor_kind", "transition_kind", "from_assessment", "to_assessment"], "patternProperties": {"^actor_kind$": {"const": "human"}, "^transition_kind$": {"const": "human_assessment"}, "^from_assessment$": {"type": "string"}, "^to_assessment$": {"enum": ["accepted", "contested", "unsupported", "deprecated"]}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
