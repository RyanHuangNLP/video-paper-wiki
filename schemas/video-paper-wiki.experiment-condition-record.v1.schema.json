{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.experiment-condition-record.v1.schema.json",
  "title": "video-paper-wiki.experiment-condition-record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "condition_id",
    "previous_record_id",
    "recorded_by",
    "recorded_at",
    "paper_id",
    "source_association",
    "source_digest",
    "code_binding",
    "setting_key",
    "conditions",
    "claim_refs",
    "content_sha256",
    "publication",
    "typed_fact_promotion",
    "canonical_official",
    "current_supported_typed_fact"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.experiment-condition-record.v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
    },
    "condition_id": {
      "type": "string",
      "pattern": "^exc-[0-9a-f]{20}$(?![\\s\\S])"
    },
    "previous_record_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
        }
      ]
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recorded_at": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/utc_timestamp"
    },
    "paper_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
    },
    "source_association": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-proposal.v1.schema.json#/$defs/association_ref"
    },
    "source_digest": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-proposal.v1.schema.json#/$defs/byte_digest"
    },
    "code_binding": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/code_binding"
        }
      ]
    },
    "setting_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$(?![\\s\\S])"
    },
    "conditions": {
      "$ref": "#/$defs/conditions"
    },
    "claim_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim_ref"
      }
    },
    "content_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "publication": {
      "const": "unpublished"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    }
  },
  "$defs": {
    "value_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "locator",
            "quote_sha256"
          ],
          "properties": {
            "kind": {
              "const": "paper_direct"
            },
            "locator": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-proposal.v1.schema.json#/$defs/paper_direct_locator"
            },
            "quote_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "locator",
            "quote_sha256"
          ],
          "properties": {
            "kind": {
              "const": "project_page"
            },
            "locator": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-proposal.v1.schema.json#/$defs/project_page_evidence"
            },
            "quote_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "locator",
            "quote_sha256"
          ],
          "properties": {
            "kind": {
              "const": "repository_text"
            },
            "locator": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-proposal.v1.schema.json#/$defs/repository_text_locator"
            },
            "quote_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            }
          }
        }
      ]
    },
    "search_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_paths",
        "search_terms"
      ],
      "properties": {
        "artifact_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "anyOf": [
              {
                "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/portable_vault_relative_path"
              },
              {
                "allOf": [
                  {
                    "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/captured_artifact_path"
                  },
                  {
                    "type": "string",
                    "pattern": "^[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/derived_artifact_path"
                  },
                  {
                    "type": "string",
                    "pattern": "^[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
                  }
                ]
              }
            ]
          }
        },
        "search_terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "code_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "annotation_id",
