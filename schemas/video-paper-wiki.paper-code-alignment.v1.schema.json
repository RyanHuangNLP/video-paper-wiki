{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.paper-code-alignment.v1.schema.json",
  "title": "video-paper-wiki.paper-code-alignment.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "paper_id", "repository", "commit", "officiality", "license", "archived", "capabilities"],
  "properties": {
    "schema": {"const": "video-paper-wiki.paper-code-alignment.v1"},
    "paper_id": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"},
    "repository": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/repository"},
    "commit": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/full_commit"},
    "officiality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["official", "unofficial", "unverified_candidate"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/pdf_locator"}
        }
      },
      "allOf": [
        {
          "if": {"required": ["status"], "patternProperties": {"^status$": {"const": "official"}}},
          "then": {"patternProperties": {"^evidence$": {"minItems": 1}}}
        }
      ]
    },
    "license": {"$ref": "#/$defs/license"},
    "archived": {"type": "boolean"},
    "capabilities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/capability"},
      "allOf": [
        {"contains": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "training"}, "status": {"enum": ["present", "absent", "partial", "unverified"]}, "locators": {"type": "array"}, "absence_scope": {"type": ["object", "null"]}, "checkpoint_kind": {"enum": ["link_only", "artifact_verified"]}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "inference"}, "status": {"enum": ["present", "absent", "partial", "unverified"]}, "locators": {"type": "array"}, "absence_scope": {"type": ["object", "null"]}, "checkpoint_kind": {"enum": ["link_only", "artifact_verified"]}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "data"}, "status": {"enum": ["present", "absent", "partial", "unverified"]}, "locators": {"type": "array"}, "absence_scope": {"type": ["object", "null"]}, "checkpoint_kind": {"enum": ["link_only", "artifact_verified"]}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "evaluation"}, "status": {"enum": ["present", "absent", "partial", "unverified"]}, "locators": {"type": "array"}, "absence_scope": {"type": ["object", "null"]}, "checkpoint_kind": {"enum": ["link_only", "artifact_verified"]}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "checkpoints"}, "status": {"enum": ["present", "absent", "partial", "unverified"]}, "locators": {"type": "array"}, "absence_scope": {"type": ["object", "null"]}, "checkpoint_kind": {"enum": ["link_only", "artifact_verified"]}}}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_id", "notes"],
      "properties": {
        "spdx_id": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    },
    "absence_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree_prefix", "search_patterns"],
      "properties": {
        "commit": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/full_commit"},
        "tree_prefix": {"type": "string"},
        "search_patterns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "locators"],
      "properties": {
        "name": {"enum": ["training", "inference", "data", "evaluation", "checkpoints"]},
        "status": {"enum": ["present", "absent", "partial", "unverified"]},
        "locators": {
          "type": "array",
          "items": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/code_locator"}
        },
        "absence_scope": {"$ref": "#/$defs/absence_scope"},
        "checkpoint_kind": {"enum": ["link_only", "artifact_verified"]}
      },
      "allOf": [
        {
          "if": {"required": ["status"], "patternProperties": {"^status$": {"const": "absent"}}},
          "then": {"required": ["absence_scope"]}
        },
        {
          "if": {"required": ["status"], "patternProperties": {"^status$": {"enum": ["present", "partial"]}}},
          "then": {"patternProperties": {"^locators$": {"minItems": 1}}}
        },
        {
          "if": {"required": ["checkpoint_kind"]},
          "then": {"patternProperties": {"^name$": {"const": "checkpoints"}}}
        }
      ]
    }
  }
}
