{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.markdown-source-observation.v1.schema.json",
  "title": "video-paper-wiki.markdown-source-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "paper_id",
    "light_paper_id",
    "title",
    "version",
    "markdown",
    "source_metadata_sha256",
    "original_pdf_sha256",
    "pages"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.markdown-source-observation.v1"
    },
    "paper_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
    },
    "light_paper_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "version": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "label"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "label": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "label"
          ],
          "properties": {
            "kind": {
              "const": "declared"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "source_metadata_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "original_pdf_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "anchor",
          "text_start",
          "text_end",
          "text_sha256"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "text_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "text_end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        }
      }
    }
  }
}
