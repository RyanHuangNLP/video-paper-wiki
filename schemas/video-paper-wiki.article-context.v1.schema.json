{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.article-context.v1.schema.json",
  "title": "video-paper-wiki.article-context.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "question",
    "tokens",
    "paper_ids",
    "basis",
    "graph_sha256",
    "matrix_sha256",
    "papers",
    "evidence",
    "matrix",
    "relevance",
    "budget",
    "required_roles",
    "fact_source",
    "write_kind",
    "publication",
    "audit_coverage",
    "ranking",
    "typed_fact_promotion",
    "taxonomy_promotion",
    "canonical_official",
    "current_supported_typed_fact",
    "scientific_conclusion_contradiction",
    "next_action"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.article-context.v1"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "paper_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_store_inventory_sha256",
        "claim_ledger_sha256",
        "assessment_heads_sha256",
        "experiment_store_inventory_sha256"
      ],
      "properties": {
        "domain_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "claim_ledger_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "assessment_heads_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "experiment_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "graph_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "matrix_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/paper_row"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    },
    "matrix": {
      "$ref": "#/$defs/matrix"
    },
    "relevance": {
      "$ref": "#/$defs/relevance"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_limit",
        "excerpt_bytes_budget",
        "excerpt_bytes_used",
        "excerpts_withheld",
        "shortfall"
      ],
      "properties": {
        "evidence_limit": {
          "const": 1024,
          "type": "integer"
        },
        "excerpt_bytes_budget": {
          "const": 65536,
          "type": "integer"
        },
        "excerpt_bytes_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "excerpts_withheld": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "shortfall": {
          "type": "boolean"
        }
      }
    },
    "required_roles": {
      "const": [
        "question",
        "consensus",
        "differences",
        "controversies",
        "limits",
        "unknowns"
      ],
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "fact_source": {
      "const": "formal_records"
    },
    "write_kind": {
      "const": "read_only"
    },
    "publication": {
      "const": "unpublished"
    },
    "audit_coverage": {
      "const": "not_wired"
    },
    "ranking": {
      "const": "not_ranked"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "taxonomy_promotion": {
      "const": "none"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
    "scientific_conclusion_contradiction": {
      "const": false,
      "type": "boolean"
    },
    "next_action": {
      "enum": [
        "none",
        "re_record_annotation",
        "re_record_condition",
        "narrow_paper_ids"
      ]
    }
  },
  "$defs": {
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text_sha256",
            "assessment",
            "head_event_id",
            "freshness"
          ],
          "properties": {
            "text_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "assessment": {
              "enum": [
                "accepted",
                "provisional",
                "contested",
                "unsupported",
                "deprecated"
              ]
            },
            "head_event_id": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              ]
            },
            "freshness": {
              "enum": [
                "head_bound",
                "stale",
                "unannotated"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "association_id",
            "path",
            "sha256",
            "charspan",
            "excerpt_sha256",
            "relation",
            "quote_status",
            "version"
          ],
          "properties": {
            "association_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "charspan": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              }
            },
            "excerpt_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "relation": {
              "enum": [
                "supports",
                "contradicts",
                "uncertain"
              ]
            },
            "quote_status": {
              "enum": [
                "bound",
                "source_missing",
                "source_changed",
                "excerpt_changed"
              ]
            },
            "version": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_or_null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_record_id",
            "head_record_sha256",
            "version",
            "record_status",
            "association_status",
            "source_status",
            "binding_status"
          ],
          "properties": {
            "head_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "head_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "version": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_or_null"
            },
            "record_status": {
              "enum": [
                "current",
                "stale"
              ]
            },
            "association_status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "source_status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "binding_status": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_record_id",
            "head_record_sha256",
            "column",
            "status",
            "value_summary"
          ],
          "properties": {
            "head_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "head_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "column": {
              "enum": [
                "model_checkpoint",
                "parameter_count",
                "dataset_split",
                "metrics",
                "resolution",
                "frames",
                "inference_steps",
                "sampling_guidance",
                "evaluation_setup"
              ]
            },
            "status": {
              "enum": [
                "reported",
                "derived",
                "unknown",
                "not_applicable"
              ]
            },
            "value_summary": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_record_id",
            "head_record_sha256",
            "name",
            "unit",
            "value",
            "higher_is_better"
          ],
          "properties": {
            "head_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "head_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "unit": {
              "enum": [
                "score",
                "percent",
                "fvd",
                "fid",
                "kvd",
                "is",
                "clip_score",
                "ms",
                "seconds",
                "fps",
                "unitless",
                "other"
              ]
            },
            "value": {
              "type": "number"
            },
            "higher_is_better": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_annotation_id",
            "head_report_sha256",
            "repository",
            "commit",
            "relation_kind",
            "reviewed_officiality",
            "relation_status"
          ],
          "properties": {
            "head_annotation_id": {
              "type": "string",
              "pattern": "^dan-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "head_report_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "repository": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/repository"
            },
            "commit": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/full_commit"
            },
            "relation_kind": {
              "enum": [
                "this_paper_implementation",
                "baseline",
                "dependency",
                "third_party_reproduction",
                "unknown"
              ]
            },
            "reviewed_officiality": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            },
            "relation_status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left_record_id",
            "right_record_id",
            "left_record_sha256",
            "right_record_sha256",
            "verdict",
            "ranking",
            "contradiction_candidate_count",
            "same_paper"
          ],
          "properties": {
            "left_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "right_record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "left_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "right_record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "verdict": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "ranking": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "contradiction_candidate_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "same_paper": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "association_id",
            "version",
            "association_status",
            "source_status",
            "raw_sha256"
          ],
          "properties": {
            "association_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_or_null"
            },
            "association_status": {
              "enum": [
                "bound",
                "missing",
                "changed",
                "identity_mismatch"
              ]
            },
            "source_status": {
              "enum": [
                "bound",
                "missing",
                "changed"
              ]
            },
            "raw_sha256": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
                }
              ]
            }
          }
        }
      ]
    },
    "paper_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "status",
        "stale_reasons",
        "source_version_count",
        "lineage_count",
        "condition_count",
        "claim_count"
      ],
      "properties": {
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "status": {
          "enum": [
            "current",
            "stale"
          ]
        },
        "stale_reasons": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "source_version_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "lineage_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "condition_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "claim_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "paper_id",
        "label",
        "source",
        "binding",
        "status",
        "relevance_rank",
        "excerpt",
        "excerpt_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^aev-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "claim",
            "claim_span",
            "condition",
            "condition_value",
            "metric_value",
            "code_lineage",
            "comparability",
            "source_version"
          ]
        },
        "paper_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_kind",
            "record_id",
            "json_pointer"
          ],
          "properties": {
            "record_kind": {
              "enum": [
                "claim_ledger",
                "assessment_heads",
                "association_record",
                "experiment_record",
                "annotation",
                "review",
                "derived"
              ]
            },
            "record_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "json_pointer": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512
            }
          }
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "relevance_rank": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 48
            }
          ]
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          ]
        },
        "excerpt_status": {
          "enum": [
            "bound",
            "withheld_budget",
            "not_applicable",
            "source_missing",
            "source_changed",
            "excerpt_changed"
          ]
        }
      }
    },
    "matrix_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "condition_id",
        "record_id",
        "record_sha256",
        "paper_id",
        "source_association_id",
        "version",
        "association_status",
        "source_status",
        "setting_key",
        "code_binding",
        "claim_freshness",
        "row_status"
      ],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "condition_id": {
          "type": "string",
          "pattern": "^exc-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "record_id": {
          "type": "string",
          "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "record_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "source_association_id": {
          "type": "string",
          "minLength": 68,
          "maxLength": 68,
          "pattern": "^sva-[0-9a-f]{64}$(?![\\s\\S])"
        },
        "version": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/version_or_null"
        },
        "association_status": {
          "enum": [
            "bound",
            "missing",
            "changed",
            "identity_mismatch"
          ]
        },
        "source_status": {
          "enum": [
            "bound",
            "missing",
            "changed"
          ]
        },
        "setting_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "code_binding": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.experiment-comparison-matrix.v1.schema.json#/$defs/code_binding_view"
        },
        "claim_freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_bound",
            "stale"
          ],
          "properties": {
            "head_bound": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "stale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          }
        },
        "row_status": {
          "enum": [
            "current",
            "stale"
          ]
        }
      }
    },
    "matrix_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "column",
        "status",
        "value_summary",
        "source_count",
        "source_pointers",
        "search_scope_pointer",
        "evidence_id"
      ],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "column": {
          "enum": [
            "model_checkpoint",
            "parameter_count",
            "dataset_split",
            "metrics",
            "resolution",
            "frames",
            "inference_steps",
            "sampling_guidance",
            "evaluation_setup"
          ]
        },
        "status": {
          "enum": [
            "reported",
            "derived",
            "unknown",
            "not_applicable"
          ]
        },
        "value_summary": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          ]
        },
        "source_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "source_pointers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.experiment-comparison-matrix.v1.schema.json#/$defs/source_pointer"
          }
        },
        "search_scope_pointer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^aev-[0-9a-f]{20}$(?![\\s\\S])"
        }
      }
    },
    "metric_column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "unit": {
          "enum": [
            "score",
            "percent",
            "fvd",
            "fid",
            "kvd",
            "is",
            "clip_score",
            "ms",
            "seconds",
            "fps",
            "unitless",
            "other"
          ]
        }
      }
    },
    "metric_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "name",
        "unit",
        "value",
        "higher_is_better",
        "definition_source_pointer",
        "evidence_id"
      ],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "unit": {
          "enum": [
            "score",
            "percent",
            "fvd",
            "fid",
            "kvd",
            "is",
            "clip_score",
            "ms",
            "seconds",
            "fps",
            "unitless",
            "other"
          ]
        },
        "value": {
          "type": "number"
        },
        "higher_is_better": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "definition_source_pointer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^aev-[0-9a-f]{20}$(?![\\s\\S])"
        }
      }
    },
    "pairwise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_condition_id",
        "right_condition_id",
        "left_record_id",
        "right_record_id",
        "verdict",
        "ranking",
        "contradiction_candidate_count",
        "same_paper",
        "evidence_id"
      ],
      "properties": {
        "left_condition_id": {
          "type": "string",
          "pattern": "^exc-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "right_condition_id": {
          "type": "string",
          "pattern": "^exc-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "left_record_id": {
          "type": "string",
          "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "right_record_id": {
          "type": "string",
          "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "verdict": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "ranking": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contradiction_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "same_paper": {
          "type": "boolean"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^aev-[0-9a-f]{20}$(?![\\s\\S])"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "rows",
        "columns",
        "cells",
        "metric_columns",
        "metric_cells",
        "pairwise_summary"
      ],
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "rows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/matrix_row"
          }
        },
        "columns": {
          "const": [
            "model_checkpoint",
            "parameter_count",
            "dataset_split",
            "metrics",
            "resolution",
            "frames",
            "inference_steps",
            "sampling_guidance",
            "evaluation_setup"
          ],
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "enum": [
              "model_checkpoint",
              "parameter_count",
              "dataset_split",
              "metrics",
              "resolution",
              "frames",
              "inference_steps",
              "sampling_guidance",
              "evaluation_setup"
            ]
          }
        },
        "cells": {
          "type": "array",
          "minItems": 0,
          "maxItems": 576,
          "items": {
            "$ref": "#/$defs/matrix_cell"
          }
        },
        "metric_columns": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/metric_column"
          }
        },
        "metric_cells": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/metric_cell"
          }
        },
        "pairwise_summary": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2016,
          "items": {
            "$ref": "#/$defs/pairwise"
          }
        }
      }
    },
    "included_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "node_id",
        "kind",
        "evidence_ids",
        "fused_score",
        "ranking_reasons"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "paper",
            "source_version",
            "claim",
            "concept",
            "code_lineage",
            "capability",
            "code_ref",
            "experiment_condition"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^aev-[0-9a-f]{20}$(?![\\s\\S])"
          }
        },
        "fused_score": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "ranking_reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route",
              "rank",
              "detail"
            ],
            "properties": {
              "route": {
                "enum": [
                  "exact",
                  "graph"
                ]
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "detail": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                ]
              }
            }
          }
        }
      }
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplied",
        "fusion",
        "routes",
        "third_route",
        "included"
      ],
      "properties": {
        "supplied": {
          "type": "boolean"
        },
        "fusion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "rank_constant",
            "candidate_k",
            "score_arithmetic"
          ],
          "properties": {
            "algorithm": {
              "const": "rrf-v1"
            },
            "rank_constant": {
              "const": 60,
              "type": "integer"
            },
            "candidate_k": {
              "const": 24,
              "type": "integer"
            },
            "score_arithmetic": {
              "const": "exact_fraction"
            }
          }
        },
        "routes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "candidate_count"
              ],
              "properties": {
                "name": {
                  "const": "exact"
                },
                "candidate_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 24
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "candidate_count",
                "seed_count"
              ],
              "properties": {
                "name": {
                  "const": "graph"
                },
                "candidate_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 24
                },
                "seed_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 24
                }
              }
            }
          ],
          "items": false
        },
        "third_route": {
          "const": "not_supplied"
        },
        "included": {
          "type": "array",
          "minItems": 0,
          "maxItems": 48,
          "items": {
            "$ref": "#/$defs/included_item"
          }
        }
      }
    }
  }
}
