{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.flow-prepare.v1.schema.json",
  "title": "video-paper-wiki.flow-prepare.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "kind",
    "batch_id",
    "paper_ids",
    "outputs",
    "experiment_binding",
    "article_binding",
    "missing_inputs",
    "next_actions",
    "basis",
    "publication",
    "applied",
    "vault_written",
    "write_kind",
    "audit_coverage",
    "ranking",
    "typed_fact_promotion",
    "canonical_official",
    "current_supported_typed_fact",
    "next_action"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.flow-prepare.v1"
    },
    "state": {
      "const": "prepared"
    },
    "kind": {
      "enum": [
        "experiment",
        "article"
      ]
    },
    "batch_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
    },
    "paper_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "experiment_binding": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/experiment_binding"
        }
      ]
    },
    "article_binding": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/article_binding"
        }
      ]
    },
    "missing_inputs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.flow-status.v1.schema.json#/$defs/missing_input"
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.flow-status.v1.schema.json#/$defs/next_action_item"
      }
    },
    "basis": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.flow-status.v1.schema.json#/$defs/output_basis"
    },
    "publication": {
      "const": "unpublished"
    },
    "applied": {
      "const": false,
      "type": "boolean"
    },
    "vault_written": {
      "const": false,
      "type": "boolean"
    },
    "write_kind": {
      "const": "work_staging"
    },
    "audit_coverage": {
      "const": "not_wired"
    },
    "ranking": {
      "const": "not_ranked"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
    "next_action": {
      "const": "follow_next_actions"
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "staging",
        "consumer"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\.work/[A-Za-z0-9][A-Za-z0-9._-]*/flow/.+$"
        },
        "sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "staging": {
          "enum": [
            "new",
            "already_staged"
          ]
        },
        "consumer": {
          "enum": [
            "experiments.record --input",
            "articles.import --context",
            "articles.import --document"
          ]
        }
      }
    },
    "experiment_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "source_association_id",
        "association_record_sha256",
        "source_digest",
        "code_binding",
        "setting_key",
        "previous_record_id"
      ],
      "properties": {
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "source_association_id": {
          "type": "string",
          "minLength": 68,
          "maxLength": 68,
          "pattern": "^sva-[0-9a-f]{64}$(?![\\s\\S])"
        },
        "association_record_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "source_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "code_binding": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/code_binding"
            }
          ]
        },
        "setting_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$(?![\\s\\S])"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            }
          ]
        }
      }
    },
    "code_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "annotation_id",
        "repository",
        "commit"
      ],
      "properties": {
        "lineage_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/lineage_id"
        },
        "annotation_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-source-version-view.v1.schema.json#/$defs/annotation_id"
        },
        "repository": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/repository"
        },
        "commit": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/full_commit"
        }
      }
    },
    "article_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article_id",
        "question",
        "paper_ids",
        "context_sha256",
        "section_ids"
      ],
      "properties": {
        "article_id": {
          "type": "string",
          "pattern": "^art-[0-9a-f]{20}$(?![\\s\\S])"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "paper_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
          }
        },
        "context_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^s[1-9][0-9]?$(?![\\s\\S])"
          }
        }
      }
    }
  }
}
