{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.pdf-migration-report.v1.schema.json",
  "title": "video-paper-wiki.pdf-migration-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_sha256",
    "cache_policy",
    "status",
    "counts",
    "roots",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.pdf-migration-report.v1"
    },
    "plan_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "cache_policy": {
      "const": "keep-local"
    },
    "status": {
      "enum": [
        "CODE_READY",
        "MIGRATION_PENDING",
        "PARTIAL",
        "DONE"
      ]
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "roots": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/root_report"
      }
    },
    "items": {
      "type": "array",
      "maxItems": 65534,
      "items": {
        "$ref": "#/$defs/item_report"
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned",
        "linked",
        "unverified",
        "failed",
        "conflict",
        "missing_original",
        "excluded",
        "blocked"
      ],
      "properties": {
        "planned": {
          "type": "integer",
          "minimum": 0
        },
        "linked": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        },
        "missing_original": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "root_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "kind", "linked", "pending", "conflict", "journal_sha256"],
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "repository",
            "formal-vault",
            "notes-vault",
            "research-workspace",
            "file-cache"
          ]
        },
        "linked": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        },
        "journal_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "item_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "paper_id",
        "root_id",
        "state",
        "verification",
        "code",
        "message"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "state": {
          "enum": [
            "planned",
            "linked",
            "unverified",
            "pending",
            "conflict",
            "failed",
            "blocked"
          ]
        },
        "verification": {
          "enum": ["verified", "unverified", "none"]
        },
        "code": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
