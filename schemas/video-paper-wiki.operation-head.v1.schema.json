{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.operation-head.v1.schema.json",
  "title": "video-paper-wiki.operation-head.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sequence",
    "receipt_path",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.operation-head.v1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999999
    },
    "receipt_path": {
      "type": "string"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
