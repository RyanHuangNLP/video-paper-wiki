{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.experiment-heads.v1.schema.json",
  "title": "video-paper-wiki.experiment-heads.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "heads"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.experiment-heads.v1"
    },
    "heads": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4096,
      "patternProperties": {
        "^exc-[0-9a-f]{20}$(?![\\s\\S])": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_id",
            "record_sha256"
          ],
          "properties": {
            "record_id": {
              "type": "string",
              "pattern": "^exr-[0-9a-f]{20}$(?![\\s\\S])"
            },
            "record_sha256": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
