{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.pdf-bind-plan.v1.schema.json",
  "title": "video-paper-wiki.pdf-bind-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "root_id",
    "roots_sha256",
    "request_sha256",
    "plan_sha256",
    "items",
    "blocked"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.pdf-bind-plan.v1"
    },
    "batch_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
    },
    "root_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "roots_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "request_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "plan_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "blocked": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "paper_id",
        "binding_path",
        "page_path",
        "page_action",
        "before_binding_sha256",
        "after_binding_sha256",
        "before_page_sha256",
        "after_page_sha256",
        "page_text",
        "binding"
      ],
      "properties": {
        "item_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "binding_path": {
          "type": "string",
          "pattern": "^wiki/meta/pdf-bindings/arxiv-[0-9]{4}\\.[0-9]{4,5}\\.json$"
        },
        "page_path": {
          "type": "string",
          "pattern": "^papers/arxiv-[0-9]{4}\\.[0-9]{4,5}\\.md$"
        },
        "page_action": {
          "enum": ["create", "preserve"]
        },
        "before_binding_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "after_binding_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "before_page_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "after_page_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "page_text": {
          "type": ["string", "null"],
          "maxLength": 8192
        },
        "binding": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.pdf-binding.v1.schema.json"
        }
      }
    }
  }
}
