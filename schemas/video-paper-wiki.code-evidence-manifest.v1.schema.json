{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.code-evidence-manifest.v1.schema.json",
  "title": "video-paper-wiki.code-evidence-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "origin",
    "payload",
    "media_type",
    "encoding",
    "line_canonicalization",
    "newline_style",
    "ends_with_newline",
    "line_count",
    "normalized_sha256",
    "proposal_sha256"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.code-evidence-manifest.v1"
    },
    "state": {
      "enum": [
        "proposal",
        "inspected"
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path"
      ],
      "properties": {
        "repository": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/repository"
        },
        "commit": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/full_commit"
        },
        "path": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/portable_vault_relative_path"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      }
    },
    "media_type": {
      "const": "text/plain"
    },
    "encoding": {
      "const": "utf-8"
    },
    "line_canonicalization": {
      "const": "utf8-lf-v1"
    },
    "newline_style": {
      "enum": [
        "none",
        "lf",
        "crlf",
        "mixed"
      ]
    },
    "ends_with_newline": {
      "type": "boolean"
    },
    "line_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "normalized_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "proposal_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stored_path",
        "source_identity",
        "source_id",
        "inspection_approval_hash",
        "operation_id"
      ],
      "properties": {
        "stored_path": {
          "type": "string",
          "pattern": "^\\.raw/captured/[0-9a-f]{64}\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "source_identity": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "source_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/source_id"
        },
        "inspection_approval_hash": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "manifest_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "state"
        ],
        "patternProperties": {
          "^state$": {
            "const": "proposal"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "capture"
              ]
            },
            {
              "required": [
                "manifest_sha256"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "capture",
          "manifest_sha256"
        ]
      }
    }
  ]
}
