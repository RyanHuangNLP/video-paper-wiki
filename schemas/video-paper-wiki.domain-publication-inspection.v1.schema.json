{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-publication-inspection.v1.schema.json",
  "title": "video-paper-wiki.domain-publication-inspection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "request_sha256",
    "request",
    "basis_verified",
    "content_verified",
    "publication",
    "applied",
    "receipt_backed",
    "audit_coverage",
    "backup_coverage",
    "transaction_authority",
    "canonical_official",
    "current_supported_typed_fact",
    "next_action"
