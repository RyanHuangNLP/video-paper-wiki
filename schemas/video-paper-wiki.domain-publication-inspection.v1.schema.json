    },
    "applied": {
      "const": false,
      "type": "boolean"
    },
    "receipt_backed": {
      "const": false,
      "type": "boolean"
    },
    "audit_coverage": {
      "const": "not_wired"
    },
    "backup_coverage": {
      "const": "not_wired"
    },
    "transaction_authority": {
      "const": "not_wired"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
