{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-graph-query.v1.schema.json",
  "title": "video-paper-wiki.domain-graph-query.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "basis",
    "graph_sha256",
    "query",
    "fusion",
    "routes",
    "included",
    "omitted",
    "budget",
    "currency",
    "write_kind",
    "publication",
    "audit_coverage",
    "fact_source",
    "ranking",
    "typed_fact_promotion",
    "taxonomy_promotion",
    "canonical_official",
    "current_supported_typed_fact",
    "next_action"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.domain-graph-query.v1"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_store_inventory_sha256",
        "claim_ledger_sha256",
        "assessment_heads_sha256",
        "experiment_store_inventory_sha256"
      ],
      "properties": {
        "domain_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "claim_ledger_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "assessment_heads_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "experiment_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "graph_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "kind",
        "concept_kind",
        "paper_id",
        "limit",
        "tokens"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "all",
            "paper",
            "claim",
            "concept",
            "code",
            "config",
            "experiment"
          ]
        },
        "concept_kind": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "Method",
                "Model",
                "ArchitectureComponent",
                "TrainingRecipe",
                "Dataset",
                "Benchmark",
                "InferenceRecipe",
                "EvaluationMetric"
              ]
            }
          ]
        },
        "paper_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "fusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "rank_constant",
        "candidate_k",
        "score_arithmetic"
      ],
      "properties": {
        "algorithm": {
          "const": "rrf-v1"
        },
        "rank_constant": {
          "const": 60,
          "type": "integer"
        },
        "candidate_k": {
          "const": 24,
          "type": "integer"
        },
        "score_arithmetic": {
          "const": "exact_fraction"
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "supplied",
            "candidate_count",
            "currency"
          ],
          "properties": {
            "name": {
              "const": "exact"
            },
            "supplied": {
              "const": true,
              "type": "boolean"
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "currency": {
              "const": "formal_basis"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "supplied",
            "candidate_count",
            "currency",
            "seed_count"
          ],
          "properties": {
            "name": {
              "const": "graph"
            },
            "supplied": {
              "const": true,
              "type": "boolean"
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "currency": {
              "const": "formal_basis"
            },
            "seed_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "supplied",
            "candidate_count",
            "currency",
            "rebound_units",
            "unbound_units"
          ],
          "properties": {
            "name": {
              "const": "bm25"
            },
            "supplied": {
              "type": "boolean"
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "currency": {
              "enum": [
                "not_supplied",
                "unit_rebound_only"
              ]
            },
            "rebound_units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "unbound_units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            }
          }
        }
      ],
      "items": false
    },
    "included": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "node_id",
          "kind",
          "label",
          "paper_id",
          "status",
          "stale_reasons",
          "fused_score",
          "ranking_reasons",
          "quote_spans",
          "support",
          "oppose_evidence",
          "recovery"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "paper",
              "source_version",
              "claim",
              "concept",
              "code_lineage",
              "capability",
              "code_ref",
              "experiment_condition"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "paper_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
              }
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "stale_reasons": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "uniqueItems": true
          },
          "fused_score": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "denominator": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          },
          "ranking_reasons": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "route",
                "rank",
                "detail"
              ],
              "properties": {
                "route": {
                  "enum": [
                    "exact",
                    "graph",
                    "bm25"
                  ]
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 24
                },
                "detail": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  ]
                }
              }
            }
          },
          "quote_spans": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "record_kind",
                "record_id",
                "json_pointer",
                "path",
                "span",
                "quote_sha256",
                "relation",
                "status",
                "excerpt"
              ],
              "properties": {
                "record_kind": {
                  "enum": [
                    "claim_ledger",
                    "experiment_record"
                  ]
                },
                "record_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "json_pointer": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 512
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "span": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 8388608
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 8388608
                        }
                      }
                    }
                  ]
                },
                "quote_sha256": {
                  "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
                },
                "relation": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "supports",
                        "contradicts",
                        "uncertain"
                      ]
                    }
                  ]
                },
                "status": {
                  "enum": [
                    "bound",
                    "source_missing",
                    "source_changed",
                    "excerpt_changed",
                    "withheld_budget",
                    "not_rechecked"
                  ]
                },
                "excerpt": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    }
                  ]
                }
              }
            }
          },
          "support": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "supports",
              "contradicts",
              "uncertain"
            ],
            "properties": {
              "supports": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              "contradicts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              "uncertain": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              }
            }
          },
          "oppose_evidence": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "other_node_id",
                "record_id",
                "json_pointer",
                "verdict",
                "ranking"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "claim_contradicts",
                    "contradiction_candidate"
                  ]
                },
                "other_node_id": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  ]
                },
                "record_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "json_pointer": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 512
                },
                "verdict": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  ]
                },
                "ranking": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  ]
                }
              }
            }
          },
          "recovery": {
            "enum": [
              "none",
              "re_record_annotation",
              "re_record_condition",
              "repair_store"
            ]
          }
        }
      }
    },
    "omitted": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "kind",
          "reason"
        ],
        "properties": {
          "node_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            ]
          },
          "kind": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "paper",
                  "source_version",
                  "claim",
                  "concept",
                  "code_lineage",
                  "capability",
                  "code_ref",
                  "experiment_condition"
                ]
              }
            ]
          },
          "reason": {
            "enum": [
              "budget_limit",
              "bm25_unit_unbound",
              "bm25_owner_mismatch",
              "bm25_paper_unknown",
              "kind_filter",
              "concept_kind_filter"
            ]
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "candidate_k",
        "quote_bytes_budget",
        "quote_bytes_used",
        "quote_spans_per_item",
        "fused_total",
        "included_count",
        "omitted_by_budget",
        "quotes_withheld",
        "routes_not_supplied",
        "shortfall"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "candidate_k": {
          "const": 24,
          "type": "integer"
        },
        "quote_bytes_budget": {
          "const": 8192,
          "type": "integer"
        },
        "quote_bytes_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "quote_spans_per_item": {
          "const": 4,
          "type": "integer"
        },
        "fused_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 72
        },
        "included_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "omitted_by_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 72
        },
        "quotes_withheld": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "routes_not_supplied": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "items": {
            "enum": [
              "bm25"
            ]
          },
          "uniqueItems": true
        },
        "shortfall": {
          "type": "boolean"
        }
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_basis",
        "source_catalog",
        "bm25"
      ],
      "properties": {
        "formal_basis": {
          "const": "verified"
        },
        "source_catalog": {
          "const": "not_consulted"
        },
        "bm25": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "binding"
              ],
              "properties": {
                "binding": {
                  "const": "not_supplied"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "binding",
                "join_generation_sha256",
                "mapping_sha256",
                "retrieval_config_sha256",
                "catalog_generation_sha256"
              ],
              "properties": {
                "binding": {
                  "const": "unit_rebound_only"
                },
                "join_generation_sha256": {
                  "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
                },
                "mapping_sha256": {
                  "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
                },
                "retrieval_config_sha256": {
                  "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
                },
                "catalog_generation_sha256": {
                  "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
                }
              }
            }
          ]
        }
      }
    },
    "write_kind": {
      "const": "read_only"
    },
    "publication": {
      "const": "unpublished"
    },
    "audit_coverage": {
      "const": "not_wired"
    },
    "fact_source": {
      "const": "formal_records"
    },
    "ranking": {
      "const": "not_ranked"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "taxonomy_promotion": {
      "const": "none"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
    "next_action": {
      "enum": [
        "none",
        "re_record_annotation",
        "re_record_condition",
        "repair_store",
        "rebuild_bm25_index",
        "narrow_query_or_raise_limit"
      ]
    }
  }
}
