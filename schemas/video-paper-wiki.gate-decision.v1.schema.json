{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.gate-decision.v1.schema.json",
  "title": "video-paper-wiki.gate-decision.v1",
  "$comment": "event_id = \"gde-\" + SHA256(RFC8785-JCS(gate decision without event_id)).hexdigest()[:20]. This is the human-only HUMAN-GATE-BASELINE-001 single event chain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gate_id", "event_id", "previous_event_id", "actor_kind", "choice", "baseline_manifest_sha256", "derived_full_map_repo_ids", "decided_by", "decided_at", "reason"],
  "properties": {
    "schema": {"const": "video-paper-wiki.gate-decision.v1"},
    "gate_id": {"const": "HUMAN-GATE-BASELINE-001"},
    "event_id": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/gate_event_id"},
    "previous_event_id": {"type": ["string", "null"], "pattern": "^gde-[0-9a-f]{20}$"},
    "actor_kind": {"const": "human"},
    "choice": {"enum": ["keep-modelscope", "replace-with-open-sora"]},
    "baseline_manifest_sha256": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"},
    "derived_full_map_repo_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/repo_id"}
    },
    "decided_by": {"type": "string", "minLength": 1},
    "decided_at": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/utc_timestamp"},
    "reason": {"type": "string", "minLength": 1}
  }
}
