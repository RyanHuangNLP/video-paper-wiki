{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.pdf-binding.v1.schema.json",
  "title": "video-paper-wiki.pdf-binding.v1",
  "$comment": "PDF-location source registration for a notes vault. Not a capture, receipt, or paper-record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "paper_id",
    "pdf_sha256",
    "size_bytes",
    "media_type",
    "local_ref",
    "identity_basis",
    "intake",
    "identity_credential",
    "source_url",
    "registration"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.pdf-binding.v1"
    },
    "paper_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
    },
    "pdf_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "media_type": {
      "const": "application/pdf"
    },
    "local_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "relative_path"],
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        }
      }
    },
    "identity_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root_id", "relative_path", "scanned_sha256"],
      "properties": {
        "kind": {
          "enum": ["seed", "existing-note"]
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(docs/seed/engine-mvp\\.json|papers/arxiv-[0-9]{4}\\.[0-9]{4,5}\\.md)$"
        },
        "scanned_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "content_sha256", "intake_id"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^\\.work/research/[A-Za-z0-9](?:[A-Za-z0-9_-]{0,126}[A-Za-z0-9])?/manual-pdf/intakes/[0-9a-f]{64}\\.json$"
        },
        "content_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "intake_id": {
          "type": "string",
          "pattern": "^mp1-intake-[0-9a-f]{64}$"
        }
      }
    },
    "identity_credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "seed_paper_id", "arxiv_id", "title"],
      "properties": {
        "method": {
          "const": "seed-catalog"
        },
        "seed_paper_id": {
          "type": "string",
          "pattern": "^arxiv-[0-9]{4}\\.[0-9]{4,5}$"
        },
        "arxiv_id": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://arxiv\\.org/abs/[0-9]{4}\\.[0-9]{4,5}$"
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "capture_authorized", "receipt_backed"],
      "properties": {
        "role": {
          "const": "pdf-location-source"
        },
        "capture_authorized": {
          "const": false
        },
        "receipt_backed": {
          "const": false
        }
      }
    }
  }
}
