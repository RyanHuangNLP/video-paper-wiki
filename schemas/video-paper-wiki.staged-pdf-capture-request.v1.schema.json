{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.staged-pdf-capture-request.v1.schema.json",
  "title": "video-paper-wiki.staged-pdf-capture-request.v1",
  "$comment": "The embedded approval-ref is an external digest binding, not proof of human approval or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "plan",
    "approval_ref",
    "approval_ref_sha256",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.staged-pdf-capture-request.v1"
    },
    "batch_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "size_bytes",
        "approval_hash",
        "plan_kind",
        "stable_subject_id",
        "input_kind",
        "limits_sha256",
        "network_targets_sha256",
        "pipeline_fingerprint"
      ],
      "properties": {
        "file": {
          "const": "plan/ingest-plan.v1.json"
        },
        "sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "approval_hash": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "plan_kind": {
          "const": "paper-source"
        },
        "stable_subject_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/stable_subject_id"
        },
        "input_kind": {
          "enum": [
            "local-blob",
            "arxiv"
          ]
        },
        "limits_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "network_targets_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "pipeline_fingerprint": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "approval_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "plan_approval_hash",
        "plan_kind",
        "batch_id",
        "stable_subject_id",
        "input_sha256",
        "limits_sha256",
        "network_targets_sha256",
        "pipeline_fingerprint"
      ],
      "properties": {
        "format": {
          "const": "video-paper-wiki.approval-ref.v1"
        },
        "plan_approval_hash": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "plan_kind": {
          "const": "paper-source"
        },
        "batch_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
        },
        "stable_subject_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/stable_subject_id"
        },
        "input_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "limits_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "network_targets_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "pipeline_fingerprint": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "approval_ref_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "size_bytes",
        "media_type",
        "page_count"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^prepared/[0-9a-f]{64}\\.blob$(?![\\s\\S])",
          "minLength": 78,
          "maxLength": 78
        },
        "sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 67108864
        },
        "media_type": {
          "const": "application/pdf"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    }
  }
}
