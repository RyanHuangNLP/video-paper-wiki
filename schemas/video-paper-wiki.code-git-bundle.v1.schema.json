{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.code-git-bundle.v1.schema.json",
  "title": "video-paper-wiki.code-git-bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "video-paper-wiki.code-git-bundle.v1"
    },
    "kind": {
      "const": "code-git-bundle"
    },
    "id": {
      "type": "string",
      "pattern": "\\A(?:ce1:code-git-bundle:[0-9a-f]{64})\\Z",
