{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.operation-result-authority.v1.schema.json",
  "title": "video-paper-wiki.operation-result-authority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transaction",
    "result",
    "bundle_sha256",
    "vault_before",
    "vault_after"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.operation-result-authority.v1"
    },
    "transaction": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.transaction-facade.v1.schema.json"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation_id",
        "operation_type",
        "bundle_sha256",
        "expanded_bundle_sha256",
        "approval_sha256",
        "status",
        "changed_paths",
        "hashes",
        "modes"
      ],
      "properties": {
        "schema": {
          "const": "claude-obsidian.transaction-result.v1"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
        },
        "operation_type": {
          "enum": [
            "capture",
            "ingest",
            "generic"
          ]
        },
        "bundle_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "expanded_bundle_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "approval_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "status": {
          "const": "complete"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hashes": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[\\s\\S]+$(?![\\s\\S])": {
              "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
            }
          }
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[\\s\\S]+$(?![\\s\\S])": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            }
          }
        }
      }
    },
    "bundle_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "vault_before": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[\\s\\S]+$(?![\\s\\S])": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "mode"
              ],
              "properties": {
                "sha256": {
                  "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
                },
                "mode": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 511
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "vault_after": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[\\s\\S]+$(?![\\s\\S])": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "mode"
              ],
              "properties": {
                "sha256": {
                  "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
                },
                "mode": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 511
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
