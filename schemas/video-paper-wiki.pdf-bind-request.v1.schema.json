{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.pdf-bind-request.v1.schema.json",
  "title": "video-paper-wiki.pdf-bind-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.pdf-bind-request.v1"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "identity_basis",
        "intake",
        "local_ref",
        "pdf_sha256",
        "size_bytes",
        "identity_credential"
      ],
      "properties": {
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "identity_basis": {
          "$ref": "#/$defs/identity_basis"
        },
        "intake": {
          "$ref": "#/$defs/intake_ref"
        },
        "local_ref": {
          "$ref": "#/$defs/local_ref"
        },
        "pdf_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "identity_credential": {
          "$ref": "#/$defs/identity_credential"
        }
      }
    },
    "identity_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root_id", "relative_path", "scanned_sha256"],
      "properties": {
        "kind": {
          "enum": ["seed", "existing-note"]
        },
        "root_id": {
          "$ref": "#/$defs/root_id"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(docs/seed/engine-mvp\\.json|papers/arxiv-[0-9]{4}\\.[0-9]{4,5}\\.md)$"
        },
        "scanned_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "intake_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^\\.work/research/[A-Za-z0-9](?:[A-Za-z0-9_-]{0,126}[A-Za-z0-9])?/manual-pdf/intakes/[0-9a-f]{64}\\.json$"
        }
      }
    },
    "local_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "relative_path"],
      "properties": {
        "root_id": {
          "$ref": "#/$defs/root_id"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        }
      }
    },
    "identity_credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "seed_paper_id", "arxiv_id", "title"],
      "properties": {
        "method": {
          "const": "seed-catalog"
        },
        "seed_paper_id": {
          "type": "string",
          "pattern": "^arxiv-[0-9]{4}\\.[0-9]{4,5}$"
        },
        "arxiv_id": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "root_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
