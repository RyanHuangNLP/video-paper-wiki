{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.experiment-publication-request.v1.schema.json",
  "title": "video-paper-wiki.experiment-publication-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "kind",
    "basis",
    "prospective_inventory_sha256",
    "touched_conditions",
    "payloads",
    "publication",
    "applied",
    "receipt_backed",
    "audit_coverage",
    "transaction_authority",
    "canonical_official",
    "current_supported_typed_fact",
    "typed_fact_promotion",
    "ranking",
    "next_action"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.experiment-publication-request.v1"
    },
    "batch_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
    },
    "kind": {
      "const": "experiments"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_store_inventory_sha256",
        "claim_ledger_sha256",
        "assessment_heads_sha256",
        "experiment_store_inventory_sha256"
      ],
      "properties": {
        "domain_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "claim_ledger_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "assessment_heads_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "experiment_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "prospective_inventory_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "touched_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 24,
        "maxLength": 24,
        "pattern": "^exc-[0-9a-f]{20}$(?![\\s\\S])"
      }
    },
    "payloads": {
      "type": "array",
      "minItems": 2,
      "maxItems": 513,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mode",
          "before_sha256",
          "after_sha256",
          "size_bytes",
          "content_file"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 32,
            "maxLength": 84,
            "pattern": "^wiki/meta/experiments/(?:records/exc-[0-9a-f]{20}/exr-[0-9a-f]{20}\\.json|heads\\.json)$(?![\\s\\S])"
          },
          "mode": {
            "enum": [
              "create",
              "replace"
            ]
          },
          "before_sha256": {
            "anyOf": [
              {
                "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "after_sha256": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "content_file": {
            "type": "string",
            "minLength": 95,
            "maxLength": 95,
            "pattern": "^experiment-publication/content/[0-9a-f]{64}$(?![\\s\\S])"
          }
        }
      }
    },
    "publication": {
      "const": "unpublished"
    },
    "applied": {
      "const": false,
      "type": "boolean"
    },
    "receipt_backed": {
      "const": false,
      "type": "boolean"
    },
    "audit_coverage": {
      "const": "not_wired"
    },
    "transaction_authority": {
      "const": "not_wired"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "ranking": {
      "const": "not_ranked"
    },
    "next_action": {
      "const": "inspect_experiment_publication"
    }
  }
}
