{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.upstream-capture-authority.v1.schema.json",
  "title": "video-paper-wiki.upstream-capture-authority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "upstream",
    "request",
    "transport",
    "observation",
    "inspection"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.upstream-capture-authority.v1"
    },
    "profile": {
      "const": "claude-obsidian-capture-apply-dry-run-9f8c119-v1"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "commit",
        "tree",
        "tracked_and_untracked_clean",
        "profile_sha256",
        "source_snapshot_sha256"
      ],
      "properties": {
        "distribution": {"const": "claude-obsidian"},
        "version": {"const": "2.1.1"},
        "commit": {"const": "9f8c1199047eac2c3828496279fbb7ba9540b90b"},
        "tree": {"const": "b00665e266988fe99138e761dbbf4da04b2ddb5a"},
        "tracked_and_untracked_clean": {"const": true},
        "profile_sha256": {"const": "fa5864b3dcbc9880689110e4aa36ede500b785cb2c2ca1290ca9b52817ef8dd6"},
        "source_snapshot_sha256": {"const": "94148615f5aec9c137a7b449d869de0ca2a85e92e10581eafb7de4f799a18c34"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "source_path", "operation_id", "generated_at", "budget"],
      "properties": {
        "route": {"const": "manual-inbox"},
        "source_path": {
          "type": "string",
          "minLength": 11,
          "maxLength": 1024,
          "pattern": "^inbox/[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*\\.pdf$(?![\\s\\S])"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 20,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_items", "max_total_bytes", "max_file_bytes", "max_captured_directory_entries"],
          "properties": {
            "max_items": {"const": 1},
            "max_total_bytes": {"const": 67108864},
            "max_file_bytes": {"const": 67108864},
            "max_captured_directory_entries": {"const": 4096}
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout_sha256", "stdout_size_bytes"],
      "properties": {
        "stdout_sha256": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"},
        "stdout_size_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "item", "operation", "approved_plan_sha256", "generated_at"],
      "properties": {
        "status": {"enum": ["dry-run", "noop"]},
        "item": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema", "adapter", "execute", "source_identity", "source",
            "stored_path", "would_change", "skip_reason", "metadata"
          ],
          "properties": {
            "schema": {"const": "claude-obsidian.filesystem-capture-plan.v1"},
            "adapter": {"const": "filesystem"},
            "execute": {"const": false},
            "source_identity": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"},
            "source": {
              "type": "string",
              "minLength": 11,
              "maxLength": 1024,
              "pattern": "^inbox/[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*\\.pdf$(?![\\s\\S])"
            },
            "stored_path": {
              "type": "string",
              "minLength": 80,
              "maxLength": 2048,
              "pattern": "^\\.raw/captured/[0-9a-f]{64}\\.[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
            },
            "would_change": {"type": "boolean"},
            "skip_reason": {"enum": [null, "content-unchanged"]},
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "extension", "size_bytes", "sha256", "kind", "media_type", "detected_by"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 240,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.pdf$(?![\\s\\S])"
                },
                "extension": {"const": ".pdf"},
                "size_bytes": {"type": "integer", "minimum": 5, "maximum": 67108864},
                "sha256": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"},
                "kind": {"const": "pdf"},
                "media_type": {"const": "application/pdf"},
                "detected_by": {"const": "magic"}
              }
            }
          }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "operation_id", "operation_type", "expected_path", "write"],
          "properties": {
            "schema": {"const": "claude-obsidian.transaction.v1"},
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
            },
            "operation_type": {"const": "capture"},
            "expected_path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 80,
                  "maxLength": 2048,
                  "pattern": "^\\.raw/captured/[0-9a-f]{64}\\.[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
                },
                {"type": "null"}
              ]
            },
            "write": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "mode", "sha256"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 80,
                      "maxLength": 2048,
                      "pattern": "^\\.raw/captured/[0-9a-f]{64}\\.[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
                    },
                    "mode": {"const": "create"},
                    "sha256": {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"}
                  }
                },
                {"type": "null"}
              ]
            }
          }
        },
        "approved_plan_sha256": {
          "anyOf": [
            {"$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "minLength": 20,
              "maxLength": 20,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
            },
            {"type": "null"}
          ]
        }
      }
    },
    "inspection": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.capture-inspection.v1.schema.json"
    }
  }
}
