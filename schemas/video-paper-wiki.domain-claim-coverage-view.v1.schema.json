{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.domain-claim-coverage-view.v1.schema.json",
  "title": "video-paper-wiki.domain-claim-coverage-view.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "basis",
    "paper_filter",
    "ledger_claim_count",
    "lineage_count",
    "lineages",
    "claims",
    "papers",
    "findings",
    "publication",
    "write_kind",
    "audit_coverage",
    "code_freshness",
    "evidence_recheck",
    "typed_fact_promotion",
    "experiment_conditions",
    "canonical_official",
    "current_supported_typed_fact",
    "next_action"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.domain-claim-coverage-view.v1"
    },
    "basis": {
      "$ref": "#/$defs/basis"
    },
    "paper_filter": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        }
      ]
    },
    "ledger_claim_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 131072
    },
    "lineage_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "lineages": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/lineage_view"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 262144,
      "items": {
        "$ref": "#/$defs/registry_claim"
      }
    },
    "papers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/paper_view"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1048576,
      "items": {
        "$ref": "#/$defs/finding_row"
      }
    },
    "publication": {
      "const": "unpublished"
    },
    "write_kind": {
      "const": "read_only"
    },
    "audit_coverage": {
      "const": "not_wired"
    },
    "code_freshness": {
      "const": "not_checked"
    },
    "evidence_recheck": {
      "const": "not_performed"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "experiment_conditions": {
      "const": "not_modeled"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
    "next_action": {
      "enum": [
        "none",
        "review_findings",
        "re_record_annotation"
      ]
    }
  },
  "$defs": {
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_store_inventory_sha256",
        "claim_ledger_sha256",
        "assessment_heads_sha256"
      ],
      "properties": {
        "domain_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "claim_ledger_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "assessment_heads_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "lineage_id": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^dln-[0-9a-f]{20}$(?![\\s\\S])"
    },
    "annotation_id": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^dan-[0-9a-f]{20}$(?![\\s\\S])"
    },
    "review_id": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^drv-[0-9a-f]{20}$(?![\\s\\S])"
    },
    "association_id": {
      "type": "string",
      "minLength": 68,
      "maxLength": 68,
      "pattern": "^sva-[0-9a-f]{64}$(?![\\s\\S])"
    },
    "relation_kind": {
      "enum": [
        "this_paper_implementation",
        "baseline",
        "dependency",
        "third_party_reproduction",
        "unknown"
      ]
    },
    "reviewed_officiality": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "official",
            "unofficial",
            "unverified_candidate"
          ]
        }
      ]
    },
    "coverage_status": {
      "enum": [
        "proposal_only",
        "reviewed_accepted",
        "reviewed_contested",
        "reviewed_rejected",
        "stale"
      ]
    },
    "review_decision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "accepted",
            "contested",
            "rejected"
          ]
        }
      ]
    },
    "assessment": {
      "enum": [
        "accepted",
        "provisional",
        "contested",
        "unsupported",
        "deprecated"
      ]
    },
    "assessment_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/assessment"
        }
      ]
    },
    "claim_kind": {
      "enum": [
        "architecture",
        "training",
        "empirical_result",
        "implementation",
        "ablation",
        "limitation",
        "reproducibility",
        "license",
        "resource_requirement"
      ]
    },
    "ledger_status": {
      "enum": [
        "present",
        "missing"
      ]
    },
    "freshness": {
      "enum": [
        "head_bound",
        "stale"
      ]
    },
    "stale_reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "claim_missing",
            "claim_text_changed",
            "evidence_changed",
            "assessment_head_changed"
          ]
        }
      ]
    },
    "evidence_profile": {
      "enum": [
        "legacy-v1",
        "mixed-v2"
      ]
    },
    "assessment_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_sha256",
        "evidence_profile"
      ],
      "properties": {
        "event_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/assessment_event_id"
        },
        "event_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "evidence_profile": {
          "$ref": "#/$defs/evidence_profile"
        }
      }
    },
    "claim_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_bound",
        "stale"
      ],
      "properties": {
        "head_bound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "stale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "kind_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ids",
        "head_bound",
        "stale"
      ],
      "properties": {
        "claim_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/claim_id"
          }
        },
        "head_bound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "stale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "kinds_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "training",
        "empirical_result",
        "implementation",
        "ablation",
        "limitation",
        "reproducibility",
        "license",
        "resource_requirement"
      ],
      "properties": {
        "architecture": {
          "$ref": "#/$defs/kind_cell"
        },
        "training": {
          "$ref": "#/$defs/kind_cell"
        },
        "empirical_result": {
          "$ref": "#/$defs/kind_cell"
        },
        "implementation": {
          "$ref": "#/$defs/kind_cell"
        },
        "ablation": {
          "$ref": "#/$defs/kind_cell"
        },
        "limitation": {
          "$ref": "#/$defs/kind_cell"
        },
        "reproducibility": {
          "$ref": "#/$defs/kind_cell"
        },
        "license": {
          "$ref": "#/$defs/kind_cell"
        },
        "resource_requirement": {
          "$ref": "#/$defs/kind_cell"
        }
      }
    },
    "kind_count_value": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "kind_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "training",
        "empirical_result",
        "implementation",
        "ablation",
        "limitation",
        "reproducibility",
        "license",
        "resource_requirement"
      ],
      "properties": {
        "architecture": {
          "$ref": "#/$defs/kind_count_value"
        },
        "training": {
          "$ref": "#/$defs/kind_count_value"
        },
        "empirical_result": {
          "$ref": "#/$defs/kind_count_value"
        },
        "implementation": {
          "$ref": "#/$defs/kind_count_value"
        },
        "ablation": {
          "$ref": "#/$defs/kind_count_value"
        },
        "limitation": {
          "$ref": "#/$defs/kind_count_value"
        },
        "reproducibility": {
          "$ref": "#/$defs/kind_count_value"
        },
        "license": {
          "$ref": "#/$defs/kind_count_value"
        },
        "resource_requirement": {
          "$ref": "#/$defs/kind_count_value"
        }
      }
    },
    "typed_claim_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_kind",
        "recorded_assessment",
        "current_assessment",
        "assessment_drift",
        "ledger_status",
        "claim_text_sha256",
        "evidence_fingerprint",
        "assessment_head",
        "freshness",
        "stale_reason",
        "first_annotation_id",
        "binding_revisions"
      ],
      "properties": {
        "claim_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/claim_id"
        },
        "claim_kind": {
          "$ref": "#/$defs/claim_kind"
        },
        "recorded_assessment": {
          "$ref": "#/$defs/assessment"
        },
        "current_assessment": {
          "$ref": "#/$defs/assessment_or_null"
        },
        "assessment_drift": {
          "type": "boolean"
        },
        "ledger_status": {
          "$ref": "#/$defs/ledger_status"
        },
        "claim_text_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "evidence_fingerprint": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "assessment_head": {
          "$ref": "#/$defs/assessment_head"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "stale_reason": {
          "$ref": "#/$defs/stale_reason"
        },
        "first_annotation_id": {
          "$ref": "#/$defs/annotation_id"
        },
        "binding_revisions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "untyped_claim_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_text_sha256",
        "recorded_assessment",
        "ledger_status",
        "current_assessment"
      ],
      "properties": {
        "claim_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/claim_id"
        },
        "claim_text_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "recorded_assessment": {
          "$ref": "#/$defs/assessment"
        },
        "ledger_status": {
          "$ref": "#/$defs/ledger_status"
        },
        "current_assessment": {
          "$ref": "#/$defs/assessment_or_null"
        }
      }
    },
    "history_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims_added",
        "claims_removed",
        "claims_retyped",
        "claims_rebound",
        "untyped_changed"
      ],
      "properties": {
        "claims_added": {
          "$ref": "#/$defs/claim_id_list"
        },
        "claims_removed": {
          "$ref": "#/$defs/claim_id_list"
        },
        "claims_retyped": {
          "$ref": "#/$defs/claim_id_list"
        },
        "claims_rebound": {
          "$ref": "#/$defs/claim_id_list"
        },
        "untyped_changed": {
          "type": "boolean"
        }
      }
    },
    "claim_id_list": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/claim_id"
      }
    },
    "history_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "previous_annotation_id",
        "recorded_at",
        "commit",
        "report_sha256",
        "typed_claim_count",
        "untyped_claim_count",
        "kind_counts",
        "changes_from_previous"
      ],
      "properties": {
        "annotation_id": {
          "$ref": "#/$defs/annotation_id"
        },
        "previous_annotation_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/annotation_id"
            }
          ]
        },
        "recorded_at": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/utc_timestamp"
        },
        "commit": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/full_commit"
        },
        "report_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "typed_claim_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "untyped_claim_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "kind_counts": {
          "$ref": "#/$defs/kind_counts"
        },
        "changes_from_previous": {
          "$ref": "#/$defs/history_changes"
        }
      }
    },
    "lineage_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "paper_id",
        "source_association_id",
        "source_digest_sha256",
        "repository",
        "commit",
        "head_annotation_id",
        "head_report_sha256",
        "current_review_id",
        "review_decision",
        "reviewed_officiality",
        "relation_kind",
        "coverage_status",
        "claim_freshness",
        "typed_claim_count",
        "untyped_claim_count",
        "claims",
        "kinds",
        "untyped",
        "history"
      ],
      "properties": {
        "lineage_id": {
          "$ref": "#/$defs/lineage_id"
        },
        "paper_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
        },
        "source_association_id": {
          "$ref": "#/$defs/association_id"
        },
        "source_digest_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "repository": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/repository"
        },
        "commit": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/full_commit"
        },
        "head_annotation_id": {
          "$ref": "#/$defs/annotation_id"
        },
        "head_report_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "current_review_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/review_id"
            }
          ]
        },
        "review_decision": {
          "$ref": "#/$defs/review_decision"
        },
        "reviewed_officiality": {
          "$ref": "#/$defs/reviewed_officiality"
        },
        "relation_kind": {
          "$ref": "#/$defs/relation_kind"
        },
        "coverage_status": {
          "$ref": "#/$defs/coverage_status"
        },
        "claim_freshness": {
          "$ref": "#/$defs/claim_freshness"
        },
        "typed_claim_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "untyped_claim_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/typed_claim_row"
          }
        },
        "kinds": {
          "$ref": "#/$defs/kinds_object"
        },
        "untyped": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/untyped_claim_row"
          }
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/history_row"
          }
        }
      }
    },
    "registry_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_kinds",
        "recorded_assessments",
        "evidence_fingerprints",
        "event_sha256s",
        "ledger_status",
        "current_assessment",
        "paper_ids",
        "lineage_ids",
        "head_bound",
        "stale"
      ],
      "properties": {
        "claim_id": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/claim_id"
        },
        "claim_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claim_kind"
          }
        },
        "recorded_assessments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        },
        "evidence_fingerprints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
          }
        },
        "event_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
          }
        },
        "ledger_status": {
          "$ref": "#/$defs/ledger_status"
        },
        "current_assessment": {
          "$ref": "#/$defs/assessment_or_null"
        },
        "paper_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/canonical_paper_id"
          }
        },
        "lineage_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lineage_id"
          }
        },
        "head_bound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "stale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "paper_source_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_association_id",
        "source_digest_sha256s",
        "repositories",
        "lineage_ids"
      ],
      "properties": {
        "source_association_id": {
          "$ref": "#/$defs/association_id"
        },
        "source_digest_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
          }
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/repository"
          }
        },
        "lineage_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lineage_id"
          }
        }
      }
    },
    "paper_lineage_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "source_association_id",
        "commit",
        "relation_kind",
        "reviewed_officiality",
        "coverage_status",
