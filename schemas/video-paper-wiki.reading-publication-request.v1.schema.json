{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/schemas/video-paper-wiki.reading-publication-request.v1.schema.json",
  "title": "video-paper-wiki.reading-publication-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "kind",
    "install_path",
    "reading_notes_root",
    "manifest_sha256",
    "basis",
    "graph_sha256",
    "matrix_sha256",
    "articles_batch",
    "paper_filter",
    "counts",
    "payloads",
    "foreign_paths",
    "write_plan_counts",
    "publication",
    "applied",
    "vault_written",
    "receipt_backed",
    "audit_coverage",
    "backup_coverage",
    "transaction_authority",
    "canonical_official",
    "current_supported_typed_fact",
    "typed_fact_promotion",
    "ranking",
    "next_action"
  ],
  "properties": {
    "schema": {
      "const": "video-paper-wiki.reading-publication-request.v1"
    },
    "batch_id": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
    },
    "kind": {
      "const": "reading"
    },
    "install_path": {
      "const": "wiki/reading"
    },
    "reading_notes_root": {
      "const": "wiki/reading-notes"
    },
    "manifest_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_store_inventory_sha256",
        "claim_ledger_sha256",
        "assessment_heads_sha256",
        "experiment_store_inventory_sha256",
        "article_store_inventory_sha256"
      ],
      "properties": {
        "domain_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "claim_ledger_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "assessment_heads_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "experiment_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        },
        "article_store_inventory_sha256": {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "graph_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "matrix_sha256": {
      "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
    },
    "articles_batch": {
      "anyOf": [
        {
          "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/batch_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "paper_filter": {
      "const": null
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "papers",
        "versions",
        "concepts",
        "claims",
        "lineages",
        "conditions",
        "pairwise",
        "articles",
        "pages"
      ],
      "properties": {
        "papers": {
          "type": "integer",
          "minimum": 0
        },
        "versions": {
          "type": "integer",
          "minimum": 0
        },
        "concepts": {
          "type": "integer",
          "minimum": 0
        },
        "claims": {
          "type": "integer",
          "minimum": 0
        },
        "lineages": {
          "type": "integer",
          "minimum": 0
        },
        "conditions": {
          "type": "integer",
          "minimum": 0
        },
        "pairwise": {
          "type": "integer",
          "minimum": 0
        },
        "articles": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mode",
          "before_sha256",
          "after_sha256",
          "size_bytes",
          "staged_path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 17,
            "maxLength": 1024,
            "pattern": "^wiki/reading/(?:[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*\\.md|manifest\\.json)$(?![\\s\\S])"
          },
          "mode": {
            "enum": [
              "create",
              "replace",
              "keep",
              "delete"
            ]
          },
          "before_sha256": {
            "anyOf": [
              {
                "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "after_sha256": {
            "anyOf": [
              {
                "$ref": "https://video-paper-wiki.dev/schemas/video-paper-wiki.common.v1.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 8388608
              },
              {
                "type": "null"
              }
            ]
          },
          "staged_path": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^reading/[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*\\.md$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "foreign_paths": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8192,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 14,
        "maxLength": 1024,
        "pattern": "^wiki/reading/[^\\x00/][^\\x00]*$(?![\\s\\S])"
      }
    },
    "write_plan_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "replace",
        "keep",
        "delete",
        "foreign"
      ],
      "properties": {
        "create": {
          "type": "integer",
          "minimum": 0
        },
        "replace": {
          "type": "integer",
          "minimum": 0
        },
        "keep": {
          "type": "integer",
          "minimum": 0
        },
        "delete": {
          "type": "integer",
          "minimum": 0
        },
        "foreign": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "publication": {
      "const": "unpublished"
    },
    "applied": {
      "const": false,
      "type": "boolean"
    },
    "vault_written": {
      "const": false,
      "type": "boolean"
    },
    "receipt_backed": {
      "const": false,
      "type": "boolean"
    },
    "audit_coverage": {
      "const": "not_wired"
    },
    "backup_coverage": {
      "const": "not_wired"
    },
    "transaction_authority": {
      "const": "not_wired"
    },
    "canonical_official": {
      "const": false,
      "type": "boolean"
    },
    "current_supported_typed_fact": {
      "const": false,
      "type": "boolean"
    },
    "typed_fact_promotion": {
      "const": "none"
    },
    "ranking": {
      "const": "not_ranked"
    },
    "next_action": {
      "const": "inspect_reading_publication"
    }
  }
}
