{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.local/research/research-config.v1.schema.json",
  "title": "video-paper-wiki-research.research-config.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "content_sha256",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "video-paper-wiki-research.research-config.v1"
    },
    "kind": {
      "const": "research-config"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^rw3:research-config:[0-9a-f]{64}$"
    },
    "content_sha256": {
      "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
    },
    "data": {
      "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/config"
    }
  }
}
