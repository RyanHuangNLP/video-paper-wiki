{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.local/research/paper-rank.v1.schema.json",
  "title": "video-paper-wiki-research.paper-rank.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "content_sha256",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "video-paper-wiki-research.paper-rank.v1"
    },
    "kind": {
      "const": "paper-rank"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^rw3:paper-rank:[0-9a-f]{64}$"
    },
    "content_sha256": {
      "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "sequence",
        "plan_id",
        "input_set_sha256",
        "candidate_set",
        "lists",
        "fused"
      ],
      "properties": {
        "session": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "plan_id": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/id"
        },
        "input_set_sha256": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
        },
        "candidate_set": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "lists": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "entries"
            ],
            "properties": {
              "key": {
                "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/list_key"
              },
              "entries": {
                "type": "array",
                "items": {
                  "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/list_entry"
                },
                "minItems": 0,
                "maxItems": 256
              }
            }
          },
          "minItems": 0,
          "maxItems": 128
        },
        "fused": {
          "type": "array",
          "items": {
            "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/fused"
          },
          "minItems": 0,
          "maxItems": 256
        }
      }
    }
  }
}
