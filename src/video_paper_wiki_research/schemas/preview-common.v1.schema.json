{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json",
  "title": "video-paper-wiki-research.preview-common.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {},
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "identity_source",
        "reason"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identity_source": {
          "enum": [
            "platform_reported",
            "self_reported",
            "unknown"
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rw1:(request|observation|metadata|preview|decision):[0-9a-f]{64}$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_sentence",
        "research_question",
        "method",
        "contributions_results",
        "limitations",
        "relevance"
      ],
      "properties": {
        "one_sentence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "classification"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "classification": {
              "enum": [
                "extracted",
                "inferred",
                "ambiguous",
                "unknown"
              ]
            }
          }
        },
        "research_question": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "classification"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "classification": {
              "enum": [
                "extracted",
                "inferred",
                "ambiguous",
                "unknown"
              ]
            }
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "classification"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "classification": {
              "enum": [
                "extracted",
                "inferred",
                "ambiguous",
                "unknown"
              ]
            }
          }
        },
        "contributions_results": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "classification"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "classification": {
              "enum": [
                "extracted",
                "inferred",
                "ambiguous",
                "unknown"
              ]
            }
          }
        },
        "limitations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "classification"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "classification": {
              "enum": [
                "extracted",
                "inferred",
                "ambiguous",
                "unknown"
              ]
            }
          }
        },
        "relevance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "classification"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "classification": {
              "enum": [
                "extracted",
                "inferred",
                "ambiguous",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "runtime"
      ],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "identity_source",
            "reason"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "identity_source": {
              "enum": [
                "platform_reported",
                "self_reported",
                "unknown"
              ]
            },
            "reason": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "identity_source",
            "reason"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "identity_source": {
              "enum": [
                "platform_reported",
                "self_reported",
                "unknown"
              ]
            },
            "reason": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_requests",
        "deadline_seconds",
        "max_normalized_bytes",
        "max_transport_bytes",
        "min_interval_seconds",
        "max_redirects"
      ],
      "properties": {
        "max_requests": {
          "const": 1
        },
        "deadline_seconds": {
          "const": 20
        },
        "max_normalized_bytes": {
          "const": 1048576
        },
        "max_transport_bytes": {
          "const": 1048576
        },
        "min_interval_seconds": {
          "const": 3
        },
        "max_redirects": {
          "const": 2
        }
      }
    }
  }
}
