{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.local/research/research-round-plan.v1.schema.json",
  "title": "video-paper-wiki-research.research-round-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "content_sha256",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "video-paper-wiki-research.research-round-plan.v1"
    },
    "kind": {
      "const": "research-round-plan"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^rw3:research-round-plan:[0-9a-f]{64}$"
    },
    "content_sha256": {
      "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "sequence",
        "previous_round",
        "control_head",
        "request_specs",
        "reservation_after"
      ],
      "properties": {
        "session": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "previous_round": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_head": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_specs": {
          "type": "array",
          "items": {
            "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/spec"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "reservation_after": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/reservation"
        }
      }
    }
  }
}
