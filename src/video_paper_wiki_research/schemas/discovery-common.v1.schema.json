{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json",
  "title": "video-paper-wiki-research.discovery-common.v1",
  "$defs": {
    "sha": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^rw3:[a-z-]+:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/id"
        },
        "sha256": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
        }
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "time": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "date": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4094,
      "pattern": "^[hH][tT][tT][pP][sS]://"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "namespace": {
      "enum": [
        "doi",
        "arxiv",
        "openalex"
      ]
    },
    "unversioned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "value"
      ],
      "properties": {
        "namespace": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/namespace"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "value",
        "version"
      ],
      "properties": {
        "namespace": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/namespace"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/identifier"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "unversioned_ids": {
      "type": "array",
      "items": {
        "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/unversioned"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "lens": {
      "enum": [
        "method",
        "benchmark",
        "implementation",
        "counterevidence",
        "reproduction"
      ]
    },
    "operation": {
      "enum": [
        "lookup",
        "references",
        "citations",
        "related",
        "topic",
        "project"
      ]
    },
    "provider": {
      "enum": [
        "openalex-rest-normalized-v1",
        "platform-web-search-normalized-v1"
      ]
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "identity_source",
            "reason"
          ],
          "properties": {
            "value": {
              "const": "unknown"
            },
            "identity_source": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "identity_source",
            "reason"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "identity_source": {
              "enum": [
                "platform_reported",
                "self_reported"
              ]
            },
            "reason": {
              "const": null
            }
          }
        }
      ]
    },
    "executor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_name",
            "identity_source",
            "capability_profile",
            "locator",
            "reason"
          ],
          "properties": {
            "tool_name": {
              "const": "unknown"
            },
            "identity_source": {
              "const": "unknown"
            },
            "capability_profile": {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/provider"
            },
            "locator": {
              "anyOf": [
                {
                  "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/url"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_name",
            "identity_source",
            "capability_profile",
            "locator",
            "reason"
          ],
          "properties": {
            "tool_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "identity_source": {
              "enum": [
                "platform_reported",
                "self_reported"
              ]
            },
            "capability_profile": {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/provider"
            },
            "locator": {
              "anyOf": [
                {
                  "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/url"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "const": null
            }
          }
        }
      ]
    },
    "mirror": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group",
            "provenance",
            "reason"
          ],
          "properties": {
            "group": {
              "const": null
            },
            "provenance": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group",
            "provenance",
            "reason"
          ],
          "properties": {
            "group": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "provenance": {
              "enum": [
                "provider_reported",
                "host_observed"
              ]
            },
            "reason": {
              "const": null
            }
          }
        }
      ]
    },
    "user_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "text",
        "source",
        "recorded_at"
      ],
      "properties": {
        "event_id": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/slug"
        },
        "text": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/text"
        },
        "source": {
          "enum": [
            "user_message",
            "fixture"
          ]
        },
        "recorded_at": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/time"
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "ids",
        "title",
        "author_terms",
        "project_terms"
      ],
      "properties": {
        "key": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/slug"
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/identifier"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "author_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "project_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "lens_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens",
        "terms",
        "scope"
      ],
      "properties": {
        "lens": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/lens"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "payload_bytes",
        "per_page",
        "per_round_requests",
        "requests",
        "results_per_observation",
        "rounds",
        "total_payload_bytes",
        "total_results",
        "unique_candidates"
      ],
      "properties": {
        "observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "per_round_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "results_per_observation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "total_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "total_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "unique_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "seeds",
        "query_terms",
        "lenses",
        "limits",
        "ranking",
        "stopping"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "seeds": {
          "type": "array",
          "items": {
            "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/seed"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "query_terms": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/terms"
        },
        "lenses": {
          "type": "array",
          "items": {
            "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/lens_config"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "limits": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/limits"
        },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rrf_k",
            "score_scale"
          ],
          "properties": {
            "rrf_k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "score_scale": {
              "const": 1000000
            }
          }
        },
        "stopping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consecutive_rounds",
            "min_new_relevant",
            "duplicate_percent"
          ],
          "properties": {
            "consecutive_rounds": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            },
            "min_new_relevant": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "duplicate_percent": {
              "type": "integer",
              "minimum": 50,
              "maximum": 100
            }
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_set",
        "candidate_key"
      ],
      "properties": {
        "candidate_set": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "candidate_key": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation",
        "reason"
      ],
      "properties": {
        "observation": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "reason": {
          "enum": [
            "timeout",
            "rate_limited",
            "capability_changed",
            "transient_failure"
          ]
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_key",
        "provider",
        "operation",
        "seed_key",
        "subject_ids",
        "subject_origin",
        "lens",
        "query",
        "per_page",
        "cursor",
        "continuation",
        "retry",
        "neighbor_ids",
        "depth"
      ],
      "properties": {
        "request_key": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
        },
        "provider": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/provider"
        },
        "operation": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/operation"
        },
        "seed_key": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/slug"
        },
        "subject_ids": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ids"
        },
        "subject_origin": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "lens": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/lens"
        },
        "query": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[!-~]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/retry"
            },
            {
              "type": "null"
            }
          ]
        },
        "neighbor_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/identifier"
              },
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "http_get"
            },
            "url": {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/url"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "query",
            "max_results"
          ],
          "properties": {
            "kind": {
              "const": "web_search"
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      ]
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rounds_planned",
        "request_slots_reserved",
        "observation_slots_reserved",
        "retry_slots"
      ],
      "properties": {
        "rounds_planned": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "request_slots_reserved": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "observation_slots_reserved": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "retry_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retry_after_seconds"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/text"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "identity_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right",
        "relation",
        "locator"
      ],
      "properties": {
        "left": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/identifier"
        },
        "right": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/identifier"
        },
        "relation": {
          "enum": [
            "same_work",
            "preprint_of",
            "published_as"
          ]
        },
        "locator": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/url"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "ids",
        "identity_links",
        "title",
        "summary",
        "authors",
        "published_at",
        "cited_by_count",
        "provider_score",
        "locator",
        "relation",
        "referenced_ids",
        "related_ids",
        "mirror"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "ids": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ids"
        },
        "identity_links": {
          "type": "array",
          "items": {
            "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/identity_link"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/text"
            },
            {
