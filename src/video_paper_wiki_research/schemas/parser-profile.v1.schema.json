{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.parser-profile.v1.schema.json",
  "title": "video-paper-wiki-research.parser-profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "content_sha256", "data"],
  "properties": {
    "schema": {"const": "video-paper-wiki-research.parser-profile.v1"},
    "id": {"type": "string", "pattern": "^mp1-profile-[0-9a-f]{64}$"},
    "content_sha256": {"$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.common.v1.schema.json#/$defs/sha256"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parser", "parser_config", "model_manifest"],
      "properties": {
        "parser": {"$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.common.v1.schema.json#/$defs/parser"},
        "parser_config": {"$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.common.v1.schema.json#/$defs/parser_config"},
        "model_manifest": {"$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.common.v1.schema.json#/$defs/model_manifest"}
      }
    }
  }
}
