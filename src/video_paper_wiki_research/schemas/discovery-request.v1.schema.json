{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.local/research/discovery-request.v1.schema.json",
  "title": "video-paper-wiki-research.discovery-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "content_sha256",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "video-paper-wiki-research.discovery-request.v1"
    },
    "kind": {
      "const": "discovery-request"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^rw3:discovery-request:[0-9a-f]{64}$"
    },
    "content_sha256": {
      "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "sequence",
        "plan_id",
        "slot",
        "request_key",
        "spec",
        "target"
      ],
      "properties": {
        "session": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "plan_id": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/id"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "request_key": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
        },
        "spec": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/spec"
        },
        "target": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/target"
        }
      }
    }
  }
}
