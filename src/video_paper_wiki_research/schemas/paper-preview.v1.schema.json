{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.paper-preview.v1.schema.json",
  "title": "video-paper-wiki-research.paper-preview.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "content_sha256",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "paper-preview.v1"
    },
    "kind": {
      "const": "preview"
    },
    "id": {
      "type": "string",
      "pattern": "^rw1:preview:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "content_sha256": {
      "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/sha256"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "entity_id",
        "requested_version",
        "resolved_version",
        "latest_at_observation",
        "other_versions_exist",
        "observed_at",
        "evidence_scope",
        "generator",
        "generated_at",
        "prompt_sha256",
        "sections",
        "preview_only",
        "ingest_authorized"
      ],
      "properties": {
        "metadata": {
          "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/reference"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requested_version": {
          "oneOf": [
            {
              "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/version"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_version": {
          "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/version"
        },
        "latest_at_observation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "other_versions_exist": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "observed_at": {
          "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/utc_timestamp"
        },
        "evidence_scope": {
          "const": "abstract-only"
        },
        "generator": {
          "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/generator"
        },
        "generated_at": {
          "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/utc_timestamp"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "sections": {
          "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/sections"
        },
        "preview_only": {
          "const": true
        },
        "ingest_authorized": {
          "const": false
        }
      }
    }
  }
}
