{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.local/research/discovery-observation.v1.schema.json",
  "title": "video-paper-wiki-research.discovery-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "content_sha256",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "video-paper-wiki-research.discovery-observation.v1"
    },
    "kind": {
      "const": "discovery-observation"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^rw3:discovery-observation:[0-9a-f]{64}$"
    },
    "content_sha256": {
      "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "observed_at",
        "executor",
        "outcome",
        "payload",
        "failure"
      ],
      "properties": {
        "request": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "observed_at": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/time"
        },
        "executor": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/executor"
        },
        "outcome": {
          "enum": [
            "success",
            "partial",
            "timeout",
            "rate_limited",
            "capability_unavailable",
            "failure"
          ]
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/payload"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/failure"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
