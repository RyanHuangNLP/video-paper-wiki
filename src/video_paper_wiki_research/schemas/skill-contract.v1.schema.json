{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.skill-contract.v1.schema.json",
  "title": "video-paper-wiki-research.skill-contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_name",
    "skill_revision",
    "skill_md_sha256",
    "intents",
    "commands",
    "input_schemas",
    "output_schemas",
    "allowed_tools",
    "network_policy",
    "write_policy",
    "budget",
    "retry_policy",
    "idempotency",
    "stable_errors"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-contract.v1"
    },
    "skill_name": {
      "const": "video-paper-preview"
    },
    "skill_revision": {
      "const": 1
    },
    "skill_md_sha256": {
      "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/sha256"
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "commands": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "input_schemas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "output_schemas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "allowed_tools": {
      "const": [
        "local-cli",
        "current-model",
        "platform-web-open"
      ]
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "allowed_hosts",
        "python_egress",
        "pdf_fetch"
      ],
      "properties": {
        "executor": {
          "const": "platform-read-only-web-open"
        },
        "allowed_hosts": {
          "const": [
            "arxiv.org"
          ]
        },
        "python_egress": {
          "const": false
        },
        "pdf_fetch": {
          "const": false
        }
      }
    },
    "write_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "families"
      ],
      "properties": {
        "root": {
          "const": ".work/research/<session>/preview-v1"
        },
        "families": {
          "const": [
            "requests",
            "observations",
            "metadata",
            "proposals",
            "decisions"
          ]
        }
      }
    },
    "budget": {
      "$ref": "https://video-paper-wiki.dev/research-schemas/video-paper-wiki-research.preview-common.v1.schema.json#/$defs/budget"
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_retries"
      ],
      "properties": {
        "automatic_retries": {
          "const": 0
        }
      }
    },
    "idempotency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "stable_errors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
