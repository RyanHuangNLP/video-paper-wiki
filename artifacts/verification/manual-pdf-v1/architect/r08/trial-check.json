  "claims": [
    {
      "claim": "Stable Video Diffusion identifies three LDM training stages: text-to-image pretraining, video pretraining, and high-quality video finetuning.",
      "chunk_id": "chk-eb70fc5d6d3660ae0f95ffa1",
      "source_correspondence_matches": true
    },
    {
      "claim": "The three stages are further specified as text-to-image pretraining, low-resolution video pretraining on a large dataset, and high-resolution finetuning on a smaller higher-quality set.",
      "chunk_id": "chk-aac6ae977da7da1ebb2d98e4",
      "source_correspondence_matches": true
    },
    {
      "claim": "The authors separately analyze three distinct stages of video model training for impact on final performance.",
      "chunk_id": "chk-445957a680ec2c7c979f7934",
      "source_correspondence_matches": true
    },
    {
      "claim": "VBench is a comprehensive benchmark suite for video generative models.",
      "chunk_id": "chk-53993f2dc5a3e6f49d46fe60",
      "source_correspondence_matches": true
    },
    {
      "claim": "VBench comprises 16 dimensions, including subject identity inconsistency, motion smoothness, temporal flickering, and spatial relationship.",
      "chunk_id": "chk-53993f2dc5a3e6f49d46fe60",
      "source_correspondence_matches": true
    },
    {
      "claim": "VBench decomposes quality into Video Quality and Video-Condition Consistency rather than a single-valued score.",
      "chunk_id": "chk-a2e18961ae5ae833903d46c5",
      "source_correspondence_matches": true
    },
    {
      "claim": "SANA-Video 2.0 is a hybrid video diffusion transformer at 5B and 14B scales.",
      "chunk_id": "chk-2de70a6c333fc1bc8f50367c",
      "source_correspondence_matches": true
    },
    {
      "claim": "Hybrid Linear–Softmax Attention uses gated linear mixing with periodic gated-softmax anchors at a 3:1 ratio (25% softmax).",
      "chunk_id": "chk-2de70a6c333fc1bc8f50367c",
      "source_correspondence_matches": true
    },
    {
      "claim": "Block Attention Residuals (AttnRes) boost deep-layer effective rank by about 12%.",
      "chunk_id": "chk-2de70a6c333fc1bc8f50367c",
      "source_correspondence_matches": true
    },
    {
      "claim": "With 40-step sampling, SANA-Video 2.0 reports VBench 84.30 in 13.2s at 480p on a single H100.",
      "chunk_id": "chk-2de70a6c333fc1bc8f50367c",
      "source_correspondence_matches": true
    },
    {
      "claim": "Stable Video Diffusion is a latent video diffusion model for high-resolution text-to-video and image-to-video.",
      "chunk_id": "chk-eb70fc5d6d3660ae0f95ffa1",
      "source_correspondence_matches": true
    },
    {
      "claim": "SANA-Video 2.0 uses a mostly-linear backbone with softmax anchors to keep O(N) scaling for long high-resolution video.",
      "chunk_id": "chk-ad295a399767a8361ec6d0dd",
      "source_correspondence_matches": true
    },
    {
      "claim": "Chinese draft: SVD 三阶段为文生图预训练、视频预训练、高质量视频微调。",
      "chunk_id": "chk-eb70fc5d6d3660ae0f95ffa1",
      "source_correspondence_matches": true
    },
    {
      "claim": "Chinese draft: SANA-Video 2.0 为 5B/14B 混合结构，3:1 线性-softmax，AttnRes 约 12%，40 步 480p VBench 84.30 / 13.2s。",
      "chunk_id": "chk-2de70a6c333fc1bc8f50367c",
      "source_correspondence_matches": true
    },
    {
      "claim": "Chinese draft: SVD 表示可用于图生视频微调及相机控制 LoRA。",
      "chunk_id": "chk-445957a680ec2c7c979f7934",
      "source_correspondence_matches": true
    }
