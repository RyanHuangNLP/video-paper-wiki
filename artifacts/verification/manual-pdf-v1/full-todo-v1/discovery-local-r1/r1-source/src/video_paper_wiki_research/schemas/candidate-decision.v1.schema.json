{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-paper-wiki.local/research/candidate-decision.v1.schema.json",
  "title": "video-paper-wiki-research.candidate-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "content_sha256",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "video-paper-wiki-research.candidate-decision.v1"
    },
    "kind": {
      "const": "candidate-decision"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^rw3:candidate-decision:[0-9a-f]{64}$"
    },
    "content_sha256": {
      "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "sequence",
        "previous",
        "round",
        "candidate_set",
        "candidate_key",
        "action",
        "selected_arxiv",
        "user_record"
      ],
      "properties": {
        "session": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "round": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "candidate_set": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/ref"
        },
        "candidate_key": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/sha"
        },
        "action": {
          "enum": [
            "preview",
            "skip",
            "later"
          ]
        },
        "selected_arxiv": {
          "anyOf": [
            {
              "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_record": {
          "$ref": "https://video-paper-wiki.local/research/discovery-common.v1.schema.json#/$defs/user_record"
        }
      }
    }
  }
}
