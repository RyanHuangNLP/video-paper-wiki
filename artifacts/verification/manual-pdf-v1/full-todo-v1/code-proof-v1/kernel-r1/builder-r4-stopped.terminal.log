[;m# 3. Update commit_oid if needed (though for tree mismatch, commit_oid[23m[22m[;m     [18;1H[2m┃[3m[;mstays real)[23m[22m[;m                                                                    [19;1H[2m┃[3m    [;m# 4. Re-sort since we changed oid[23m[22m[;m                                          [20;1H[2m┃[3m    args[;m[[;m"[;mobjects[;m"[;m][;m [;m=[;m [;msorted[;m(args[[;m"[;mobjects[;m"[;m][;m,[;m [;mkey[;m=[;mlambda[;m [;mr[;m: r[[;m"[;moid[;m"[;m])[23m[22m[;m          [21;1H[2m┃[22m                                                                               [22;1H[2m┃[3m    [;m# Now verify - should get HASH_MISMATCH on the tree record[23m[22m[;m                 [23;1H[2m┃[3m    [;mwith[;m [;mpytest[;m.[;mraises(verify_code_git_objects[;m.[;mInputInvalid)[;m [;mas[;m exc[;m:[23m[22m[;m           [24;1H[2m┃[3m        verify_code_git_objects.[23m[22m                                               [m[m[m[0m[24;1H













