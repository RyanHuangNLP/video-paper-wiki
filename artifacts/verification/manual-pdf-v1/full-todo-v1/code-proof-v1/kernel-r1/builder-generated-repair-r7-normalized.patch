+        }
+        pointer = "/targets/0"
+        reason = "not_closed_record"
+    else:
+        args["bodies"] = {HostileStr(key): value for key, value in args["bodies"].items()}
+        pointer = "/bodies"
+        reason = "invalid_type"
+
+    blob_rec, blob_body = _record(object_format, "blob", b"x = 1\n")
+    safe = _minimal_graph(
