def test_private_errors_suppress_outer_exception_context(resources):
    import traceback

    def _assert_outer_context_suppressed(caught, outer_marker):
        assert caught.value.__suppress_context__ is True
        assert caught.value.__cause__ is None
        assert outer_marker not in "".join(traceback.format_exception(caught.value))

    outer_unknown_title = f"{_MARKER}:active-outer:unknown-title:{id(object())}"
    try:
        raise RuntimeError(outer_unknown_title)
    except RuntimeError:
        with pytest.raises(CodeProofStructureError) as caught:
            resources.validate_structure(0, 0)
        _assert_structure(caught.value, "shape")
        _assert_outer_context_suppressed(caught, outer_unknown_title)

    outer_malformed_limits = f"{_MARKER}:active-outer:malformed-limits:{id(object())}"
    try:
        raise RuntimeError(outer_malformed_limits)
    except RuntimeError:
        with pytest.raises(CodeProofStructureError) as caught:
            resources.materialize_limits(0)
        _assert_structure(caught.value, "limits")
        _assert_outer_context_suppressed(caught, outer_malformed_limits)

    outer_direct_construction = f"{_MARKER}:active-outer:direct-construction:{id(object())}"
    try:
        raise RuntimeError(outer_direct_construction)
    except RuntimeError:
        with pytest.raises(CodeProofResourceError) as caught:
            cpr.CodeProofResources()
        _assert_resource(caught.value, "resource_shape")
        _assert_outer_context_suppressed(caught, outer_direct_construction)

    outer_retained_bytes = f"{_MARKER}:active-outer:retained-bytes:{id(object())}"
    try:
        raise RuntimeError(outer_retained_bytes)
    except RuntimeError:
        with pytest.raises(CodeProofResourceError) as caught:
            compile_code_proof_resources(0)
        _assert_resource(caught.value, "resource_shape")
        _assert_outer_context_suppressed(caught, outer_retained_bytes)

    outer_private_parser = f"{_MARKER}:active-outer:private-parser:{id(object())}"
    try:
        raise RuntimeError(outer_private_parser)
    except RuntimeError:
        with pytest.raises(CodeProofResourceError) as caught:
