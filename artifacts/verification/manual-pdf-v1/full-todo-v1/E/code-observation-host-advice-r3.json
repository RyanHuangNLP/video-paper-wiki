  "design_decision": {
    "purpose": "Freeze a host-facing profile for one bounded code observation: one paper/source association, one canonical repository, one full commit/object format, one retained bundle snapshot and an explicit complete target set.",
    "recommended_provider": "operator_supplied_local_git_bundle_v1",
    "fallback_providers": [
      "github_contents_at_commit_host_v1",
      "gitlab_repository_file_at_commit_host_v1",
      "web_text_normalized_only_v1"
    ],
    "recommendation": "Raw source authority comes only from the retained uncompressed Git proof bundle or an equivalent host-produced bundle whose object/tree/path proof is complete. Web/API snippets can supply bounded normalized text or an assertion, never exact Git source authority by themselves.",
    "trust_split": [
      "host proves acquisition/session and records provider assertion",
      "public verifier proves supplied object self-consistency, target membership and retained snapshot",
      "independent relation reviewer decides officiality and publication"
    ],
    "non_goals": [
      "agent-side GitHub/Git fetcher, clone, archive, recursive traversal or shell command",
      "automatic officiality or source-version retargeting",
      "weights/model download or executable configuration",
      "real Vault mutation or publication from a partial observation"
    ]
  },
  "request_contract": {
    "schema": "video-paper-wiki.code-observation-request.v1",
    "required_binding": [
      "paper_id",
      "optional exact source_association",
      "repository owner/name",
      "commit.git_object_format",
      "commit.oid",
      "explicit targets",
      "budgets",
      "transport"
    ],
    "repository_rule": "Canonical lowercase owner/name is selected once. A provider URL, fork, mirror, branch, tag or display head cannot replace it. Host assertion repository must equal this value.",
    "commit_rule": "Full lowercase SHA-1 (40 hex) or SHA-256 (64 hex), selected explicitly. A branch/tag is acquisition metadata only and cannot be the identity.",
    "association_rule": "If present, association_id and association_sha256 resolve to one immutable source-version record. Display-head changes create a new request; they do not retarget this request.",
    "target_rule": "Every target is one explicit relative POSIX path and role. The complete set is hashed before host invocation; duplicates, traversal, wildcard, URL query/fragment, backslash, symlink-following or recursive path fields refuse.",
    "role_policy": {
      "readme": "context/source statement; 100644 only",
      "citation": "paper/license metadata; 100644 only",
      "license": "license text; 100644 only",
      "implementation": "source implementation; 100644 or explicitly permitted 100755",
      "configuration": "closed JSON/TOML data-only evidence; 100644 only",
      "entrypoint": "bounded runnable/source entrypoint; 100644 or explicitly permitted 100755"
