  "observation_contract": {
    "schema": "video-paper-wiki.code-observation.v1",
    "one_session": "One request, one bundle_sha256, one repository, one object format, one commit/root tree and one retained source snapshot. Per-file calls may be used by the host only to populate one frozen observation; the agent never installs a mixed-generation set.",
    "required_identity": [
      "request_sha256",
      "bundle_sha256",
      "repository",
      "object_format",
      "commit_oid",
      "root_tree_oid",
      "target_set_sha256",
      "hosting_assertion_sha256"
    ],
    "target_statuses": {
      "present": "exact path/tree/blob/mode and requested raw capability proven",
      "missing": "deepest parent tree proven, exact path absent; no blob handoff",
      "inaccessible": "bounded read failed; requested target and refusal retained",
      "mismatch": "requested and observed repository/commit/tree/path/type/mode/OID/digest retained",
      "unsafe": "symlink, submodule, tree target, unsupported mode, changed retained input or unsafe bundle"
    },
    "complete_rule": "OBSERVED_COMPLETE requires all 32 requested targets present with required proof/capability. Any missing, inaccessible, mismatch, unsafe, normalized-only, invalid UTF-8 or limit overflow yields explicit partial/refusal and forbids complete publication.",
    "proof_binding": "For raw target, commit/root/intermediate tree/path walk, mode/type, blob OID, body size, body_sha256 and selected-format Git OID must agree. raw_sha256, normalized_sha256, framed_sha256 and Git OID remain separate.",
    "web_rule": "Normalized HTML/README/API text is retained with provider URL, response digest and locator as normalized-only or metadata evidence; it cannot produce blob_oid proof, exact source handoff or a legacy source manifest.",
    "observation_hash": "Hash the canonical complete observation including every target result, including failures/refusals, provider/session facts, excerpts and config evidence. Omitted failures invalidate the observation."
  },
