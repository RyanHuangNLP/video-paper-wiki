    "exceptional_sibling_cleanup": true,
    "fsync_before_atomic_replace": true,
    "helper": "_replace_same_bytes_with_distinct_inode",
    "no_skip_xfail_retry_sleep_or_equal_identity_acceptance": true,
    "original_remains_live_while_sibling_is_created": true,
    "os_replace_then_named_identity_and_bytes_reverified": true,
    "preserved_behavior": [
      "exit 2",
      "WORK_PATH_UNSAFE",
      "blob case publishes no request",
      "request case retains exact safe blob",
      "zero-network guard"
    ],
    "same_bytes_mode_size_mtime_verified": true,
    "same_directory_exclusive_no_follow_creation": true
  },
